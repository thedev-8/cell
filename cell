# Keys
# --------------------------------------------------------------------------

def resolve_key(cfg, bp, providers, flag_key=None):
    """Key priority: --api-key flag > blueprint literal > blueprint key_env >
    global [keys] > provider's key_env in your environment > provider's
    fixed token. Returns (key, source). Blueprints with auth = "login" never
    get a key: the runtime signs in by itself."""
    provider = bp.get("provider", "")
    prov = providers.get(provider, {})
    key_env = prov.get("key_env") or f"{re.sub(r'[^A-Z0-9]', '_', provider.upper())}_API_KEY"
    if flag_key:
        return flag_key, "--api-key"
    if bp.get("auth") == "login":
        return None, "login (no key)"
    if bp.get("api_key"):
        return bp["api_key"], "blueprint"
    if bp.get("key_env"):
        if os.environ.get(bp["key_env"]):
            return os.environ[bp["key_env"]], f"env ${bp['key_env']}"
        return None, f"env ${bp['key_env']} (unset!)"
    if cfg.get("keys", {}).get(provider):
        return cfg["keys"][provider], "global keys"
    if os.environ.get(key_env):
        return os.environ[key_env], f"env ${key_env}"
    if prov.get("token"):
        return prov["token"], "provider token"
    return None, None


# --------------------------------------------------------------------------
# Launch plan — built once, used by `run` and shown by `show` (dry-run)
# --------------------------------------------------------------------------

def tier_models(prov: dict, model: str) -> dict:
    tiers = {t: model for t in MODEL_TIERS}
    for t, m in (prov.get("tiers") or {}).items():
        if t in tiers and m:
            tiers[t] = m
    return tiers


def build_plan(cfg, name, cwd, api_key_flag=None):
    bp = get_blueprint(cfg, name)
    runtimes, providers = get_runtimes(cfg), get_providers(cfg)
    rt_name = bp.get("runtime", "")
    rt = runtimes.get(rt_name)
    if not rt:
        raise CellError(f"blueprint '{name}' uses unknown runtime '{rt_name}'. "
                        f"Add it with 'cell runtime add' or fix the blueprint with 'cell edit'.")
    provider = bp.get("provider", "")
    prov = providers.get(provider)
    if prov is None:
        raise CellError(f"blueprint '{name}' uses unknown provider '{provider}'. "
                        f"Add it with 'cell provider add' or fix the blueprint with 'cell edit'.")
    key, key_src = resolve_key(cfg, bp, providers, api_key_flag)
    model = bp.get("model", "")
    plan = {
        "name": name,
        "runtime": rt_name,
        "rt": rt,
        "provider": provider,
        "prov": prov,
        "model": model,
        "env_dir": instance_dir(cwd, rt_name, name),
        "key": key or "",
        "key_src": key_src,
        "key_env": prov.get("key_env"),
        "auth": bp.get("auth") or ("login" if (not key and prov.get("login")) else "key"),
        "persona": bp.get("persona", ""),
        "permissions": bp.get("permissions", ""),
        "hooks": bp.get("hooks", {}) or {},
        "settings_env": {},     # non-secret env written to settings.json (claude)
        "process_env": {},      # env exported only at launch (secrets live here)
        "drop_env": [],         # ambient vars removed from the child env
        "warnings": [],
    }
    third_party = bool(prov.get("base_url"))
    if rt.get("config") == "claude":
        if third_party:
            plan["settings_env"]["ANTHROPIC_BASE_URL"] = prov["base_url"]
            if model:
                for t, m in tier_models(prov, model).items():
                    plan["settings_env"][f"ANTHROPIC_DEFAULT_{t.upper()}_MODEL"] = m
            for k, v in (prov.get("env") or {}).items():
                plan["settings_env"][k] = str(v)
            if prov.get("auth", "token") == "api-key":
                plan["drop_env"] += ["ANTHROPIC_AUTH_TOKEN"]
                if key:
                    plan["process_env"]["ANTHROPIC_API_KEY"] = key
            else:
                plan["drop_env"] += ["ANTHROPIC_API_KEY"]
                if key:
                    plan["process_env"]["ANTHROPIC_AUTH_TOKEN"] = key
            if not key:
                plan["warnings"].append(
                    f"no API key for provider '{provider}' — set one with "
                    f"'cell keys set {provider}' or export ${plan['key_env']}")
        elif provider == "anthropic" or not prov:
            plan["drop_env"] += ["ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN"]
            if key and plan["auth"] != "login":
                plan["process_env"]["ANTHROPIC_API_KEY"] = key
            else:
                plan["drop_env"].append("ANTHROPIC_API_KEY")
        else:
            plan["warnings"].append(
                f"provider '{provider}' has no Anthropic-compatible endpoint, so the claude "
                f"runtime cannot use it. Give it a proxy URL: cell provider add {provider} "
                f"--base-url http://… --force   (or use it with the kimi runtime)")
    if key and plan["key_env"]:
        plan["process_env"].setdefault(plan["key_env"], key)
    return plan


def planned_settings(plan, cfg, existing: dict, meta: dict):
    """Compute the settings.json cell would write for a claude-style
    runtime, merging over whatever is there. Returns (new_settings, meta_updates)."""
    s = json.loads(json.dumps(existing)) if existing else {}
    env = dict(s.get("env") or {})
    for k in meta.get("managed_env", []):
        env.pop(k, None)
    env.update(plan["settings_env"])
    if env:
        s["env"] = env
    else:
        s.pop("env", None)

    # model: seed if absent, follow blueprint when it changes, otherwise
    # leave the user's in-app /model choice alone.
    applied_model = meta.get("model")
    if plan["model"] and plan["rt"].get("model_mode", "settings") == "settings":
        if "model" not in s or (applied_model is not None and applied_model != plan["model"]):
            s["model"] = plan["model"]

    if plan["permissions"]:
        mode = CLAUDE_PERMISSION_MODES.get(plan["permissions"])
        if mode:
            perms = dict(s.get("permissions") or {})
            perms["defaultMode"] = mode
            s["permissions"] = perms
            if mode == "bypassPermissions":
                s["skipDangerousModePermissionPrompt"] = True
            elif meta.get("permissions") == "bypass":
                s.pop("skipDangerousModePermissionPrompt", None)

    hooks = dict(s.get("hooks") or {})
    for ev in meta.get("managed_hooks", []):
        hooks.pop(ev, None)
    managed_hooks = []
    for key, cmd in (cfg.get("hooks") or {}).items():
        if not cmd or not plan["hooks"].get(key, True):
            continue
        ev = camel(key)
        hooks[ev] = [{"matcher": "", "hooks": [{"type": "command", "command": cmd}]}]
        managed_hooks.append(ev)
    if hooks:
        s["hooks"] = hooks
    else:
        s.pop("hooks", None)

    meta_updates = {
        "managed_env": sorted(plan["settings_env"]),
        "managed_hooks": managed_hooks,
        "model": plan["model"],
        "permissions": plan["permissions"],
    }
    return s, meta_updates


def load_settings(env_dir: Path):
    p = env_dir / SETTINGS_FILE
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as e:
        stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        bak = p.with_name(f"{SETTINGS_FILE}.broken-{stamp}")
        p.rename(bak)
        warn(f"{p} was not valid JSON ({e}); moved to {bak.name} and starting fresh")
        return {}


def git_exclude(cwd: Path, env_dir: Path):
    """Keep env dirs out of git: they hold credentials and session logs.
    Uses .git/info/exclude so nothing in the repo itself changes."""
    git = cwd / ".git"
    if not git.is_dir():
        return
    info = git / "info"
    try:
        info.mkdir(exist_ok=True)
        exc = info / "exclude"
        text = exc.read_text(encoding="utf-8") if exc.exists() else ""
        if GIT_EXCLUDE_LINE not in text.splitlines():
            with open(exc, "a", encoding="utf-8") as f:
                if text and not text.endswith("\n"):
                    f.write("\n")
                f.write(f"# cell: agent env dirs (credentials, sessions)\n{GIT_EXCLUDE_LINE}\n")
    except OSError as e:
        warn(f"could not update .git/info/exclude: {e}")
    try:
        r = subprocess.run(["git", "-C", str(cwd), "ls-files", "--error-unmatch", env_dir.name],
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0:
            warn(f"{env_dir.name} is already committed to git (it contains credentials). "
                 f"Untrack it: git rm -r --cached {env_dir.name} && git commit -m 'untrack env dir'")
    except (OSError, subprocess.SubprocessError):
        pass


def copy_seed(plan):
    src = seed_dir(plan["runtime"])
    if not src.is_dir():
        return []
    copied = []
    for p in src.rglob("*"):
        rel = p.relative_to(src)
        dst = plan["env_dir"] / rel
        if p.is_dir():
            dst.mkdir(parents=True, exist_ok=True)
        elif not dst.exists():
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(p, dst)
            copied.append(str(rel))
    return copied


def write_persona(plan):
    """Template name -> file content; file path -> symlink (copy on
    platforms without symlinks) so one shared file stays the source of truth."""
    persona = plan["persona"]
    if not persona:
        return
    pf = plan["env_dir"] / (plan["rt"].get("persona_file") or "AGENTS.md")
    src = Path(persona).expanduser()
    if src.is_file():
        src = src.resolve()
        if pf.is_symlink() and pf.resolve() == src:
            return
        if pf.exists() or pf.is_symlink():
            pf.unlink()
        try:
            pf.symlink_to(src)
        except (OSError, NotImplementedError):
            shutil.copy2(src, pf)
        return
    text, _ = resolve_template(persona)
    if text is None:
        raise CellError(f"persona '{persona}' is neither a template ({', '.join(template_names())}) "
                        f"nor an existing file")
    if pf.is_symlink():
        pf.unlink()
    if not pf.exists() or pf.read_text(encoding="utf-8") != text.rstrip("\n") + "\n":
        pf.write_text(text.rstrip("\n") + "\n", encoding="utf-8")


def kimi_register_provider(plan):
    """kimi keeps providers in its own config.toml; `kimi provider catalog add`
    fills it from the models.dev catalog. Done once per instance dir."""
    prov, key = plan["prov"], plan["key"]
    cat = prov.get("kimi_catalog")
    if plan["runtime"] != "kimi" or not cat or plan["auth"] == "login" or not key:
        return
    cfg_toml = plan["env_dir"] / "config.toml"
    if cfg_toml.exists():
        try:
            with open(cfg_toml, "rb") as f:
                if cat in (tomllib.load(f).get("providers") or {}):
                    return
        except (tomllib.TOMLDecodeError, OSError):
            pass
    cmd = [plan["rt"]["binary"], "provider", "catalog", "add", cat, "--api-key", key]
    if plan["model"]:
        cmd += ["--default-model", plan["model"].split("/", 1)[-1]]
    if prov.get("base_url_kimi"):
        cmd += ["--base-url", prov["base_url_kimi"]]
    env = dict(os.environ)
    env[plan["rt"]["env_var"]] = str(plan["env_dir"])
    print(f"registering provider '{cat}' in kimi ({' '.join(cmd[:5])} …)")
    try:
        r = subprocess.run(cmd, env=env, timeout=120)
        if r.returncode != 0:
            warn(f"kimi provider catalog add exited {r.returncode}; configure it by hand with "
                 f"'cell run {plan['name']} -- provider catalog add {cat} --api-key …'")
    except (OSError, subprocess.SubprocessError) as e:
        warn(f"could not run kimi to register the provider: {e}")


def write_instance(plan, cfg, cwd: Path):
    """Create/update the isolated env dir. Idempotent: re-run every launch.
    Only cell-managed keys are touched; everything the runtime wrote stays."""
    env_dir: Path = plan["env_dir"]
    fresh = not env_dir.exists()
    env_dir.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(env_dir, 0o700)
    except OSError:
        pass
    meta = read_meta(env_dir)
    copied = copy_seed(plan)
    write_persona(plan)

    if plan["rt"].get("config") == "claude":
        existing = load_settings(env_dir)
        new, meta_updates = planned_settings(plan, cfg, existing, meta)
        if new != existing or not (env_dir / SETTINGS_FILE).exists():
            (env_dir / SETTINGS_FILE).write_text(json.dumps(new, indent=2) + "\n", encoding="utf-8")
        meta.update(meta_updates)
    else:
        meta["model"] = plan["model"]

    kimi_register_provider(plan)
    meta.update({"name": plan["name"], "runtime": plan["runtime"],
                 "provider": plan["provider"], "cell_version": VERSION})
    (env_dir / META_FILE).write_text(dumps_toml(meta), encoding="utf-8")
    git_exclude(cwd, env_dir)
    return fresh, copied


def launch_command(plan, prompt=None, resume=None, cont=False, model=None, extra=None):
    rt = plan["rt"]
    cmd = [rt["binary"]]
    if cont and rt.get("continue_flag"):
        cmd.append(rt["continue_flag"])
    elif resume is not None and rt.get("resume_flag"):
        cmd.append(rt["resume_flag"])
        if isinstance(resume, str):
            cmd.append(resume)
    model = model or (plan["model"] if rt.get("model_mode") == "flag" else None)
    cat = plan["prov"].get("kimi_catalog")
    if model and plan["runtime"] == "kimi" and cat and "/" not in model and plan["auth"] != "login":
        model = f"{cat}/{model}"          # kimi aliases are <catalog id>/<model id>
    if model and rt.get("model_flag"):
        cmd += [rt["model_flag"], model]
    if plan["permissions"] and rt.get("permission_flags", {}).get(plan["permissions"]):
        cmd.append(rt["permission_flags"][plan["permissions"]])
    if prompt and rt.get("prompt_flag"):
        cmd += [rt["prompt_flag"], prompt]
    if extra:
        cmd += extra
    env = dict(os.environ)
    for k in plan["drop_env"]:
        env.pop(k, None)
    env[rt["env_var"]] = str(plan["env_dir"])
    env.update(plan["process_env"])
    return cmd, env


