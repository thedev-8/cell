def _get_key_arg(args, what: str) -> str:
    key = args.key
    if not key:
        if not tty():
            raise CellError("key value required (or run in a terminal to be prompted)")
        key = ask_secret(f"{what} (input hidden)")
        if not key:
            raise CellError("no key entered")
    return key


def cmd_keys(args, cfg):
    providers = get_providers(cfg)
    if args.action == "set":
        if not args.provider:
            raise CellError("provider name required: cell keys set <provider> [key]")
        if args.provider not in providers:
            warn(f"'{args.provider}' is not a known provider ({', '.join(sorted(providers))}); storing anyway")
        key = _get_key_arg(args, f"API key for {args.provider}")
        cfg["keys"][args.provider] = key
        save_config(cfg)
        print(f"stored key for '{args.provider}' ({mask(key)}) — used by every blueprint on that provider")
    elif args.action == "list":
        if not cfg["keys"]:
            print("no global keys stored (cell keys set <provider>)")
        for prov, key in sorted(cfg["keys"].items()):
            print(f"  {prov:<14} {mask(key)}")
    elif args.action == "remove":
        if not args.provider:
            raise CellError("provider name required")
        if cfg["keys"].pop(args.provider, None) is None:
            raise CellError(f"no global key stored for '{args.provider}'")
        save_config(cfg)
        print(f"removed key for '{args.provider}'")


def cmd_key(args, cfg):
    bp = get_blueprint(cfg, args.name)
    key = _get_key_arg(args, f"API key for blueprint {args.name}")
    bp["api_key"], bp["auth"], bp["key_env"] = key, "", ""
    save_config(cfg)
    print(f"key set on '{args.name}' ({mask(key)})")


def _kv_pairs(items, what):
    out = {}
    for it in items or []:
        if "=" not in it:
            raise CellError(f"{what} expects KEY=VALUE, got '{it}'")
        k, v = it.split("=", 1)
        out[k.strip()] = v.strip()
    return out


def cmd_provider(args, cfg):
    providers = get_providers(cfg)
    if args.action == "list":
        used = {}
        for bn, bp in cfg["blueprints"].items():
            used.setdefault(bp.get("provider"), []).append(bn)
        for name, p in sorted(providers.items()):
            custom = "custom " if name in cfg["providers"] and name not in DEFAULT_PROVIDERS else ""
            key = "key ✓" if cfg["keys"].get(name) else ("$" + p.get("key_env", "") if os.environ.get(p.get("key_env", "")) else "no key")
            ep = p.get("base_url") or ("login/first-party" if name == "anthropic" else "(no claude endpoint)")
            print(f"  {name:<12} {custom}{ep:<58} {key:<22} {p.get('note','')}")
            if used.get(name):
                print(f"  {'':<12} used by: {', '.join(used[name])}")
        print("\nadd your own: cell provider add NAME --base-url URL --key-env VAR   (cell provider add --help)")
    elif args.action == "show":
        if not args.name or args.name not in providers:
            raise CellError(f"provider name required, one of: {', '.join(sorted(providers))}")
        print(dumps_toml({"providers": {args.name: providers[args.name]}}), end="")
    elif args.action == "add":
        name = args.name
        if not name or not valid_name(name):
            raise CellError("provider name required (lowercase letters, digits, '-' or '_')")
        if name in providers and not args.force:
            raise CellError(f"provider '{name}' already exists (use --force to override its fields)")
        entry = dict(cfg["providers"].get(name, {}))
        if args.base_url:
            entry["base_url"] = args.base_url.rstrip("/")
        if args.key_env:
            entry["key_env"] = args.key_env
        if args.auth:
            entry["auth"] = args.auth
        if args.token:
            entry["token"] = args.token
        if args.tier:
            tiers = dict(entry.get("tiers") or {})
            for t, m in _kv_pairs(args.tier, "--tier").items():
                if t not in MODEL_TIERS:
                    raise CellError(f"--tier name must be one of {', '.join(MODEL_TIERS)}")
                tiers[t] = m
            entry["tiers"] = tiers
        if args.env:
            env = dict(entry.get("env") or {})
            env.update(_kv_pairs(args.env, "--env"))
            entry["env"] = env
        if args.kimi_catalog:
            entry["kimi_catalog"] = args.kimi_catalog
        if args.default_model:
            entry["default_model"] = args.default_model
        if args.note:
            entry["note"] = args.note
        if args.docs:
            entry["docs"] = args.docs
        if args.login:
            entry["login"] = True
        if name not in DEFAULT_PROVIDERS:
            entry.setdefault("key_env", f"{re.sub(r'[^A-Z0-9]', '_', name.upper())}_API_KEY")
            entry.setdefault("auth", "token")
            if not entry.get("base_url") and not entry.get("login"):
                warn("no --base-url: the claude runtime cannot use this provider; "
                     "other runtimes get its key via $" + entry["key_env"])
        if not entry:
            raise CellError("nothing to set — see 'cell provider add --help'")
        cfg["providers"][name] = entry
        save_config(cfg)
        print(f"{'updated' if name in providers else 'added'} provider '{name}'")
        print(f"next: cell keys set {name}   then   cell add <blueprint> --provider {name} --model <model>")
    elif args.action == "remove":
        if args.name not in cfg["providers"]:
            if args.name in DEFAULT_PROVIDERS:
                raise CellError(f"'{args.name}' is built-in; override fields with 'cell provider add {args.name} --force …'")
            raise CellError(f"unknown provider '{args.name}'")
        users = [bn for bn, bp in cfg["blueprints"].items() if bp.get("provider") == args.name]
        if users and not args.force:
            raise CellError(f"provider '{args.name}' is used by: {', '.join(users)} (use --force)")
        del cfg["providers"][args.name]
        save_config(cfg)
        print(f"removed provider '{args.name}'" + (" (built-in defaults restored)" if args.name in DEFAULT_PROVIDERS else ""))


def cmd_runtime(args, cfg):
    runtimes = get_runtimes(cfg)
    if args.action == "list":
        for name, rt in sorted(runtimes.items()):
            path = which(rt.get("binary", ""))
            state = f"installed ({path})" if path else "missing"
            custom = " (custom)" if name in cfg["runtimes"] and name not in DEFAULT_RUNTIMES else ""
            print(f"  {name:<10} {rt.get('binary','?'):<10} env: {rt.get('env_var','?'):<20} {state}{custom}")
    elif args.action == "add":
        if not args.name or not valid_name(args.name):
            raise CellError("runtime name required (lowercase letters, digits, '-' or '_')")
        if args.name in runtimes and not args.force:
            raise CellError(f"runtime '{args.name}' already exists (use --force to override fields)")
        entry = dict(cfg["runtimes"].get(args.name, {}))
        if args.name not in DEFAULT_RUNTIMES and not (args.binary and args.env_var) \
                and not (entry.get("binary") and entry.get("env_var")):
            raise CellError("runtime add needs --binary and --env-var (the env var that relocates its config dir)")
        for field in ("binary", "env_var", "prompt_flag", "resume_flag", "continue_flag",
                      "model_flag", "persona_file", "global_dir", "install_unix", "install_windows"):
            v = getattr(args, field, None)
            if v is not None:
                entry[field] = v
        if args.config:
            entry["config"] = args.config
        if args.model_mode:
            entry["model_mode"] = args.model_mode
        if args.name not in DEFAULT_RUNTIMES:
            entry.setdefault("config", "none")
            entry.setdefault("model_mode", "flag")
        cfg["runtimes"][args.name] = entry
        save_config(cfg)
        print(f"{'updated' if args.name in runtimes else 'added'} runtime '{args.name}' — no rebuild needed")
        if not which(entry.get("binary", "")):
            note(f"'{entry.get('binary')}' is not in PATH yet")
    elif args.action == "install":
        rt = runtimes.get(args.name or "")
        if not rt:
            raise CellError(f"unknown runtime '{args.name}'. Known: {', '.join(sorted(runtimes))}")
        cmd_str = rt.get("install_windows" if os.name == "nt" else "install_unix")
        if not cmd_str:
            raise CellError(f"no installer known for '{args.name}' — install it manually")
        print(f"this will run:\n  {cmd_str}")
        if not confirm("Proceed?", args.yes):
            return
        code = subprocess.call(cmd_str, shell=True)
        if code != 0:
            raise CellError(f"installer exited with {code}")
    elif args.action == "remove":
        if args.name not in cfg.get("runtimes", {}):
            if args.name in DEFAULT_RUNTIMES:
                raise CellError(f"'{args.name}' is built-in and has no overrides to remove")
            raise CellError(f"unknown runtime '{args.name}'")
        users = [bn for bn, bp in cfg["blueprints"].items() if bp.get("runtime") == args.name]
        if users and args.name not in DEFAULT_RUNTIMES and not args.force:
            raise CellError(f"runtime '{args.name}' is used by: {', '.join(users)} (use --force)")
        del cfg["runtimes"][args.name]
        save_config(cfg)
        print(f"removed runtime '{args.name}' from config")


def cmd_hooks(args, cfg):
    hooks = cfg.setdefault("hooks", {})
    if args.action == "list":
        if not hooks:
            print("no hooks configured (cell hooks set <event> '<command>', or cell hooks import <env-dir>)")
        for ev, cmd in hooks.items():
            print(f"  {ev:<20} -> {camel(ev)}\n      {cmd}")
    elif args.action == "set":
        if not args.event or not args.command:
            raise CellError("usage: cell hooks set <event> '<shell command>'   (event: stop, user_prompt_submit, post_compact, …)")
        hooks[args.event] = args.command
        save_config(cfg)
        print(f"hook '{args.event}' ({camel(args.event)}) set — applied to every claude blueprint on next run")
    elif args.action == "remove":
        if args.event not in hooks:
            raise CellError(f"no hook '{args.event}'")
        del hooks[args.event]
        save_config(cfg)
        print(f"removed hook '{args.event}'")
    elif args.action == "import":
        src = Path(args.event or ".").expanduser()
        if src.is_dir() and (src / SETTINGS_FILE).exists():
            src_dir = src
        else:
            cands = [i for i in find_instances(Path.cwd(), get_runtimes(cfg))
                     if (i["path"] / SETTINGS_FILE).exists()]
            if len(cands) != 1:
                raise CellError("give the env dir to import from: cell hooks import .claude-env-max")
            src_dir = cands[0]["path"]
        try:
            data = json.loads((src_dir / SETTINGS_FILE).read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError) as e:
            raise CellError(f"cannot read {src_dir / SETTINGS_FILE}: {e}")
        n = 0
        for ev, groups in (data.get("hooks") or {}).items():
            for g in groups:
                for h in g.get("hooks", []):
                    if h.get("type") == "command" and h.get("command"):
                        key = re.sub(r"(?<!^)(?=[A-Z])", "_", ev).lower()
                        hooks[key] = h["command"]
                        n += 1
                        break
                else:
                    continue
                break
        copied = 0
        if (src_dir / "hooks").is_dir():
            dst = seed_dir("claude") / "hooks"
            dst.mkdir(parents=True, exist_ok=True)
            for p in (src_dir / "hooks").iterdir():
                if p.is_file():
                    shutil.copy2(p, dst / p.name)
                    copied += 1
        save_config(cfg)
        print(f"imported {n} hook(s) from {src_dir}" + (f", {copied} script(s) -> {seed_dir('claude') / 'hooks'}" if copied else ""))
        print("new claude envs get them automatically; existing ones on their next 'cell run'")


