                      "SessionStart", "SessionEnd", "PermissionRequest")


def hook_key(event: str) -> str:
    """Config key for a hook event: Stop / UserPromptSubmit / user-prompt-submit
    -> stop / user_prompt_submit, so one event never ends up under two keys."""
    e = str(event or "").strip().replace("-", "_")
    if "_" not in e:
        e = re.sub(r"(?<!^)(?=[A-Z])", "_", e)
    return e.lower()


