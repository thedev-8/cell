def cmd_doctor(args, cfg):
    """Health check: one command answers 'is everything set up right?'"""
    problems = 0

    def bad(msg):
        nonlocal problems
        problems += 1
        print(f"  ✗ {msg}")

    print("config")
    if config_path().exists():
        mode = config_path().stat().st_mode & 0o777
        print(f"  ✓ {config_path()}" + ("" if mode == 0o600 or os.name == "nt" else f"  (mode {oct(mode)}, expected 0600)"))
    else:
        bad("no config yet — run 'cell init'")
    if vault_path().exists():
        mode = vault_path().stat().st_mode & 0o777
        try:
            n_keys = len(load_vault())
        except CellError as e:
            bad(str(e).splitlines()[0])
        else:
            if mode == 0o600 or os.name == "nt":
                print(f"  ✓ key vault: {n_keys} key{'' if n_keys == 1 else 's'} (owner-only)")
            else:
                bad(f"key vault is readable by others (mode {oct(mode)}): chmod 600 {vault_path()}")
    print("runtimes")
