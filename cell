SECTIONS = ("blueprints", "keys", "runtimes", "providers", "hooks", "voice", "plugins")


def empty_config() -> dict:
    return {s: {} for s in SECTIONS}


def load_config() -> dict:
    path = config_path()
    if not path.exists():
        return empty_config()
    try:
        with open(path, "rb") as f:
            cfg = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        raise CellError(f"{path} is not valid TOML: {e}\n"
                        f"fix it by hand, or move it away and run 'cell init'")
    for s in SECTIONS:
        if not isinstance(cfg.get(s), dict):
            cfg[s] = {}
    return cfg


def save_config(cfg: dict):
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".toml.tmp")
    # create with owner-only permissions before any secret is written
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(dumps_toml(cfg))
    os.replace(tmp, path)
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def _merge(defaults: dict, override: dict) -> dict:
    """Deep-merge user tables over built-in defaults (one level of nesting
    for dict-valued fields such as tiers/env/permission_flags)."""
    merged = {k: json.loads(json.dumps(v)) for k, v in defaults.items()}
    for name, table in override.items():
        if isinstance(table, dict) and isinstance(merged.get(name), dict):
            for fk, fv in table.items():
                if isinstance(fv, dict) and isinstance(merged[name].get(fk), dict):
                    merged[name][fk].update(fv)
                else:
                    merged[name][fk] = fv
        else:
            merged[name] = table
    return merged


def get_runtimes(cfg: dict) -> dict:
    return _merge(DEFAULT_RUNTIMES, cfg.get("runtimes", {}))


def get_providers(cfg: dict) -> dict:
    return _merge(DEFAULT_PROVIDERS, cfg.get("providers", {}))


def suggest(word, options) -> str:
    """' Did you mean 'x'?' for a near miss, else ''."""
    m = difflib.get_close_matches((word or "").lower(), sorted(options), n=1, cutoff=0.6)
    return f" Did you mean '{m[0]}'?" if m else ""


def resolve_blueprint(cfg: dict, name) -> str:
    """The blueprint's real name: exact, else case-insensitive (MAX -> max).
    Unknown names fail with the closest match and the full list."""
    bps = cfg.get("blueprints", {})
    if name in bps:
        return name
    for b in bps:
        if b.lower() == str(name or "").lower():
            return b
    known = ", ".join(sorted(bps)) or "(none yet — create one: cell add NAME)"
    raise CellError(f"unknown blueprint '{name}'.{suggest(name, bps)} Known: {known}")


def get_blueprint(cfg: dict, name: str) -> dict:
    return cfg["blueprints"][resolve_blueprint(cfg, name)]


