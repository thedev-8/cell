# --------------------------------------------------------------------------
# Voice input: speak a prompt, or transcribe voice notes
# --------------------------------------------------------------------------
# cell stays stdlib-only. Recording shells out to parecord / arecord /
# pw-record (raw 16 kHz mono PCM on stdout). Local transcription runs
# faster-whisper inside its own venv (~/.config/cell/voice/venv) through a
# tiny driver sent on stdin; the api engine posts to any OpenAI-compatible
# /audio/transcriptions endpoint with urllib. Nothing here touches a project.

VOICE_DEFAULTS = {
    "engine": "local",            # local (faster-whisper) | api (OpenAI-compatible endpoint)
    "model": "small",             # tiny, base, small, medium, large-v3, turbo, or a HF repo id
    "python": "",                 # interpreter that has faster_whisper; "" = cell's own venv
    "language": "",               # "" = auto-detect, else ISO code: en, hi, de, …
    "beam": 1,                    # 1 = fastest; 5 = faster-whisper's default (slower, a bit better)
    "device": "cpu",              # cpu | cuda
    "compute": "int8",            # int8 on cpu, float16 on cuda
    "silence_seconds": 1.5,       # listen: stop after this much quiet once speech was heard
    "max_seconds": 60,            # listen: hard cap
    "recorder": "auto",           # auto | command writing s16le 16 kHz mono PCM to stdout
    "api_url": "https://api.openai.com/v1",
    "api_model": "whisper-1",
    "api_key_env": "OPENAI_API_KEY",
}
VOICE_RATE = 16000
VOICE_CHUNK = VOICE_RATE // 10 * 2        # 100 ms of s16 mono
VOICE_PIP = ["faster-whisper", "av<19"]   # PyAV 19 broke faster-whisper's audio decoding (metadata_errors)

WHISPER_DRIVER = r'''
import json, os, sys
a = json.loads(sys.argv[1])
os.environ.setdefault("HF_HUB_DISABLE_PROGRESS_BARS", "1")
try:
    from faster_whisper import WhisperModel
except ImportError:
    print(json.dumps({"error": "faster_whisper is not installed in " + sys.executable}))
    sys.exit(2)
m = WhisperModel(a["model"], device=a["device"], compute_type=a["compute"], download_root=a["models"])
if a.get("warm"):
    print(json.dumps({"ok": True}))
    sys.exit(0)
segs, info = m.transcribe(a["file"], vad_filter=True, beam_size=int(a["beam"]), language=a.get("language") or None)
text = " ".join(s.text.strip() for s in segs if s.text.strip())
print(json.dumps({"text": text, "language": info.language, "duration": round(info.duration, 1)}))
'''

VOICE_SKILL = '''---
name: voice
description: Voice input through cell. Use when the user types /voice, asks you to listen, wants to speak instead of typing, or gives an audio or voice-note file (.ogg .opus .m4a .mp3 .wav .webm .flac) to transcribe, understand or act on.
---

# Voice input (cell voice)

Both commands print the transcript on stdout; status goes to stderr.

- **Spoken prompt:** run `cell voice listen` immediately, without asking first. It records from the microphone until the speaker pauses for about 1.5 s (60 s max). Treat the transcript as the user's message: quote it back in one short line, then act on it.
- **Voice file:** run `cell voice transcribe <file>` (several files: all in one command). Quote the transcript in one line, then act on it.
- Options: `--language xx` forces a language (default auto-detect); `--seconds N` records a fixed length.

If the output says the microphone captured only silence, tell the user the mic is not reaching the system (in a VM: enable audio input in the VM settings) and offer to transcribe a voice file instead. If it says voice is not set up, tell them to run `cell voice setup`.
'''


def voice_dir() -> Path:
    return config_dir() / "voice"


def voice_cfg(cfg) -> dict:
    vc = dict(VOICE_DEFAULTS)
    vc.update({k: v for k, v in (cfg.get("voice") or {}).items() if v is not None})
    return vc


def voice_python(vc) -> Path:
    if vc.get("python"):
        return Path(vc["python"]).expanduser()
    return voice_dir() / "venv" / ("Scripts/python.exe" if os.name == "nt" else "bin/python")


def voice_api_key(cfg, vc):
    return os.environ.get(vc.get("api_key_env") or "") or cfg.get("keys", {}).get("voice")


def find_recorder(vc):
    """Command that writes raw s16le 16 kHz mono PCM to stdout, and its name."""
    custom = (vc.get("recorder") or "auto").strip()
    if custom and custom != "auto":
        return shlex.split(custom), custom.split()[0]
    if which("parecord"):
        return ["parecord", "--raw", "--format=s16le", f"--rate={VOICE_RATE}", "--channels=1"], "parecord"
    if which("arecord"):
        return ["arecord", "-q", "-t", "raw", "-f", "S16_LE", "-r", str(VOICE_RATE), "-c", "1", "-"], "arecord"
    if which("pw-record"):
        return ["pw-record", "--rate", str(VOICE_RATE), "--channels", "1", "--format", "s16", "-"], "pw-record"
    if which("ffmpeg"):
        return ["ffmpeg", "-v", "quiet", "-f", "pulse", "-i", "default", "-ac", "1",
                "-ar", str(VOICE_RATE), "-f", "s16le", "-"], "ffmpeg"
    return None, None


def _level(chunk: bytes):
    a = array.array("h", chunk[: len(chunk) - len(chunk) % 2])
    if not a:
        return 0.0, 0
    return math.sqrt(sum(x * x for x in a) / len(a)), max(abs(x) for x in a)


def record_audio(vc, seconds=None, quiet=False):
    """Record the microphone to voice/last.wav. Stops after a fixed length,
    on Enter (when run from a terminal), or after `silence_seconds` of quiet
    once speech was heard. Returns (path, duration, peak)."""
    cmd, name = find_recorder(vc)
    if not cmd:
        raise CellError("no recorder found: install pulseaudio-utils (parecord), alsa-utils (arecord) or "
                        "pipewire (pw-record), or set [voice] recorder = \"<command writing s16le 16kHz mono PCM to stdout>\"")
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
    except OSError as e:
        raise CellError(f"cannot start recorder {name}: {e}")
    silence = float(vc["silence_seconds"])
    max_s = float(seconds or vc["max_seconds"])
    tty = sys.stdin.isatty() and seconds is None
    status = sys.stderr.isatty() and not quiet
    frames, floor, thr, started, last_voice, peak = [], None, 0.0, False, 0.0, 0
    if status:
        how = (f"speak, pause {silence:g}s" + (" or press Enter" if tty else "") + " to stop") if seconds is None \
            else f"recording {max_s:g}s"
        sys.stderr.write(f"● listening via {name} — {how}\n")
    try:
        while True:
            chunk = proc.stdout.read(VOICE_CHUNK)
            if not chunk:
                break
            frames.append(chunk)
            now = len(frames) * VOICE_CHUNK / (VOICE_RATE * 2)      # audio time, not wall time
            rms, pk = _level(chunk)
            peak = max(peak, pk)
            speaking = False
            if seconds is None:
                if floor is None and now >= 0.5:
                    floor = max(1.0, sum(_level(c)[0] for c in frames) / len(frames))
                    thr = max(floor * 3, 250.0)
                if floor is not None:
                    speaking = rms >= thr
                    if speaking:
                        started, last_voice = True, now
                    elif started and now - last_voice >= silence:
                        break
            if status:
                bar = "▮" * min(20, int(rms / 150))
                state = "speaking" if speaking else ("…" if started else "waiting")
                sys.stderr.write(f"\r  {now:5.1f}s {bar:<20} {state}   ")
                sys.stderr.flush()
            if now >= max_s:
                break
            if tty and select.select([sys.stdin], [], [], 0)[0]:
                sys.stdin.readline()
                break
    except KeyboardInterrupt:
        pass
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
        if status:
            sys.stderr.write("\r" + " " * 60 + "\r")
            sys.stderr.flush()
    data = b"".join(frames)
    duration = len(data) / (VOICE_RATE * 2)
    if duration < 0.3:
        raise CellError(f"recorder {name} produced no audio")
    if peak == 0:
        raise CellError("the microphone captured only silence (level 0). Check the input device "
                        "(pactl list sources short); in a VM, enable audio input in the VM's settings")
    voice_dir().mkdir(parents=True, exist_ok=True)
    path = voice_dir() / "last.wav"
    with wave.open(str(path), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(VOICE_RATE)
        w.writeframes(data)
    return path, duration, peak


def transcribe_file(cfg, path, language=None, quiet=False) -> dict:
    """-> {"text", "language", "duration"} via the configured engine."""
    if not cfg.get("voice"):
        raise CellError("voice is not set up yet: run 'cell voice setup'")
    vc = voice_cfg(cfg)
    path = Path(path).expanduser()
    if not path.is_file():
        raise CellError(f"no such audio file: {path}")
    lang = language if language is not None else (vc.get("language") or "")
    if vc["engine"] == "api":
        return _transcribe_api(cfg, vc, path, lang)
    return _transcribe_local(vc, path, lang, quiet)


def _transcribe_local(vc, path: Path, lang: str, quiet=False) -> dict:
    py = voice_python(vc)
    if not py.exists():
        raise CellError(f"{py} not found: run 'cell voice setup'")
    args = {"model": vc["model"], "device": vc["device"], "compute": vc["compute"], "beam": vc["beam"],
            "models": str(voice_dir() / "models"), "file": str(path), "language": lang}
    show = sys.stderr.isatty() and not quiet
    if show:
        sys.stderr.write(f"transcribing ({vc['model']}) …\r")
        sys.stderr.flush()
    r = subprocess.run([str(py), "-", json.dumps(args)], input=WHISPER_DRIVER, capture_output=True, text=True)
    if show:
        sys.stderr.write(" " * 40 + "\r")
        sys.stderr.flush()
    lines = (r.stdout or "").strip().splitlines()
    try:
        res = json.loads(lines[-1]) if lines else {}
    except json.JSONDecodeError:
        res = {}
    if r.returncode != 0 or "text" not in res:
        err = res.get("error") or ((r.stderr or "").strip().splitlines() or ["unknown error"])[-1]
        raise CellError(f"transcription failed: {err}")
    return res


def _transcribe_api(cfg, vc, path: Path, lang: str) -> dict:
    key = voice_api_key(cfg, vc)
    if not key:
        raise CellError(f"no key for the voice API: export {vc['api_key_env']} or 'cell keys set voice'")
    boundary = "----cell" + uuid.uuid4().hex
    fields = {"model": vc["api_model"], "response_format": "json"}
    if lang:
        fields["language"] = lang
    body = bytearray()
    for k, v in fields.items():
        body += f'--{boundary}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode()
    body += (f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{path.name}"\r\n'
             f"Content-Type: application/octet-stream\r\n\r\n").encode() + path.read_bytes() + b"\r\n"
    body += f"--{boundary}--\r\n".encode()
    req = urllib.request.Request(
        vc["api_url"].rstrip("/") + "/audio/transcriptions", data=bytes(body), method="POST",
        headers={"Authorization": f"Bearer {key}", "Content-Type": f"multipart/form-data; boundary={boundary}"})
    try:
        with urllib.request.urlopen(req, timeout=180) as resp:
            res = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        raise CellError(f"voice API {e.code}: {e.read().decode('utf-8', 'replace')[:300]}")
    except (urllib.error.URLError, OSError, json.JSONDecodeError) as e:
        raise CellError(f"voice API request failed: {e}")
    return {"text": (res.get("text") or "").strip(), "language": res.get("language") or lang or "?",
            "duration": res.get("duration")}


def voice_capture_text(cfg, seconds=None, language=None, quiet=False) -> str:
    """Record, transcribe, return the text (what 'cell voice listen' and
    'cell run --voice' share)."""
    if not cfg.get("voice"):
        raise CellError("voice is not set up yet: run 'cell voice setup'")
    path, duration, _ = record_audio(voice_cfg(cfg), seconds=seconds, quiet=quiet)
    if not quiet and sys.stderr.isatty():
        sys.stderr.write(f"recorded {duration:.1f}s\n")
    res = transcribe_file(cfg, path, language=language, quiet=quiet)
    if not res["text"]:
        raise CellError(f"no speech recognized in {duration:.1f}s of audio (saved: {path})")
    return res["text"]


def _copy_clipboard(text: str):
    for cmd in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["pbcopy"], ["clip"]):
        if which(cmd[0]):
            subprocess.run(cmd, input=text.encode("utf-8"))
            return True
    warn("no clipboard tool found (wl-copy, xclip, pbcopy)")
    return False


def write_voice_skill() -> Path:
    p = seed_dir("claude") / "skills" / "voice" / "SKILL.md"
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(VOICE_SKILL, encoding="utf-8")
    return p


def voice_setup(args, cfg):
    vc = voice_cfg(cfg)
    for k in ("engine", "model", "python", "language", "recorder", "api_url", "api_model", "api_key_env"):
        v = getattr(args, k, None)
        if v is not None:
            vc[k] = v
    print(f"── {APP} voice setup ──")
    vdir = voice_dir()
    vdir.mkdir(parents=True, exist_ok=True)
    if vc["engine"] == "local":
        py = voice_python(vc)
        if not py.exists():
            if vc["python"]:
                raise CellError(f"{py} not found")
            venv = vdir / "venv"
            print(f"venv    creating {venv} …")
            sys.stdout.flush()
            r = subprocess.run([sys.executable, "-m", "venv", str(venv)], capture_output=True, text=True)
            if r.returncode:
                raise CellError(f"python -m venv failed: {r.stderr.strip()[-300:]}\n"
                                f"(Debian/Ubuntu: sudo apt install python3-venv)")
        if subprocess.run([str(py), "-c", "import faster_whisper"], capture_output=True).returncode:
            print("engine  installing faster-whisper (one time, ~150 MB) …")
            sys.stdout.flush()
            r = subprocess.run([str(py), "-m", "pip", "install", "-q", "--disable-pip-version-check"] + VOICE_PIP)
            if r.returncode:
                raise CellError("pip install faster-whisper failed (see above)")
        print(f"engine  local faster-whisper via {py}")
        print(f"model   {vc['model']}: checking / downloading …")
        sys.stdout.flush()
        a = {"model": vc["model"], "device": vc["device"], "compute": vc["compute"],
             "models": str(vdir / "models"), "warm": True}
        r = subprocess.run([str(py), "-", json.dumps(a)], input=WHISPER_DRIVER, capture_output=True, text=True)
        if r.returncode:
            err = ((r.stderr or "").strip().splitlines() or [r.stdout.strip() or "unknown error"])[-1]
            raise CellError(f"could not load model '{vc['model']}': {err}")
        print(f"model   {vc['model']} ready in {vdir / 'models'}")
        _voice_smoke_test(vc, py)
    else:
        key = voice_api_key(cfg, vc)
        print(f"engine  api {vc['api_url']}  model {vc['api_model']}  "
              f"key: {'found' if key else 'MISSING (export ' + vc['api_key_env'] + ' or: cell keys set voice)'}")
    _, name = find_recorder(vc)
    print(f"mic     recorder: {name or 'NONE (install pulseaudio-utils, alsa-utils or pipewire)'}")
    cfg["voice"] = {k: vc[k] for k in VOICE_DEFAULTS}
    save_config(cfg)
    print(f"config  [voice] saved in {config_path()}")
    print(f"skill   {write_voice_skill()}")
    print("        every claude env gets /voice on its next 'cell run'")
    print("\ntry:    cell voice listen            cell voice transcribe note.ogg            cell run max --voice")


def _voice_smoke_test(vc, py: Path):
    """Decode + transcribe half a second of noise so a broken dependency
    (e.g. a PyAV release faster-whisper can't use) shows up at setup time."""
    probe = voice_dir() / "probe.wav"
    with wave.open(str(probe), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(VOICE_RATE)
        w.writeframes(array.array("h", [((i * 7919) % 200) - 100 for i in range(VOICE_RATE // 2)]).tobytes())
    try:
        _transcribe_local(vc, probe, "", quiet=True)
        print("check   decode + transcribe ok")
    except CellError as e:
        if "metadata_errors" in str(e) or " av" in str(e) or "av." in str(e):
            print("check   audio decoding broken by a newer PyAV — repinning …")
            subprocess.run([str(py), "-m", "pip", "install", "-q", "--disable-pip-version-check", "av<19"])
            _transcribe_local(vc, probe, "", quiet=True)
            print("check   decode + transcribe ok")
        else:
            raise
    finally:
        probe.unlink(missing_ok=True)


def cmd_voice(args, cfg):
    if args.action == "setup":
        return voice_setup(args, cfg)
    if args.action == "listen":
        text = voice_capture_text(cfg, seconds=args.seconds, language=args.language, quiet=args.quiet)
        print(json.dumps({"text": text}, ensure_ascii=False) if args.json else text)
        if args.copy:
            _copy_clipboard(text)
        return
    if args.action == "transcribe":
        if not args.files:
            raise CellError("file(s) required: cell voice transcribe FILE…")
        results = []
        for f in args.files:
            res = transcribe_file(cfg, f, language=args.language, quiet=args.quiet)
            results.append({"file": str(f), **res})
        if args.json:
            print(json.dumps(results if len(results) > 1 else results[0], ensure_ascii=False, indent=2))
        else:
            for r in results:
                if len(results) > 1:
                    print(f"== {r['file']}  ({r.get('language')}, {r.get('duration')}s)")
                print(r["text"])
        if args.copy:
            _copy_clipboard("\n\n".join(r["text"] for r in results))


