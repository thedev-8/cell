ALIASES = {"ls": "list", "rm": "remove"}
RUNTIME_FLAG_OPTS = ("--prompt-flag", "--resume-flag", "--continue-flag", "--model-flag")

COMMANDS = {
    "add": cmd_add, "edit": cmd_edit, "list": cmd_list, "remove": cmd_remove,
    "run": cmd_run, "show": cmd_show, "status": cmd_status, "doctor": cmd_doctor,
    "keys": cmd_keys, "key": cmd_key, "provider": cmd_provider, "runtime": cmd_runtime,
    "hooks": cmd_hooks, "templates": cmd_templates, "sessions": cmd_sessions,
    "clean": cmd_clean, "import": cmd_import, "init": cmd_init, "voice": cmd_voice,
    "learn": cmd_learn, "plugins": cmd_plugins, "vault": cmd_vault,
}


def rewrite_argv(argv: list) -> list:
    """Shortcuts before argparse sees the line:
    cell max -c -> cell run max -c        cell -c / cell -r -> cell run -c / -r
    cell ls / rm -> list / remove         runtime add --model-flag --model -> --model-flag=--model"""
    if not argv:
        return argv
    first = argv[0]
    if first in ALIASES:
        argv = [ALIASES[first]] + argv[1:]
    elif first in ("-r", "--resume", "-c", "--continue", "-p", "--prompt"):
        argv = ["run"] + argv
    elif not first.startswith("-") and first not in COMMANDS:
        cfg = load_config()
        try:
            argv = ["run", resolve_blueprint(cfg, first)] + argv[1:]
        except CellError:
            bps = sorted(cfg.get("blueprints", {}))
            raise CellError(f"'{first}' is not a command or a blueprint.{suggest(first, list(COMMANDS) + bps)}\n"
                            f"  commands:   {', '.join(COMMANDS)}\n"
                            f"  blueprints: {', '.join(bps) or 'none yet (cell add NAME)'}")
    if argv[0] == "runtime":
        out, i = [], 0
        while i < len(argv):
            if argv[i] in RUNTIME_FLAG_OPTS and i + 1 < len(argv) and argv[i + 1].startswith("-"):
                out.append(f"{argv[i]}={argv[i + 1]}")
                i += 2
                continue
            out.append(argv[i])
            i += 1
        argv = out
    return argv


def main():
    p = build_parser()
    argv = rewrite_argv(sys.argv[1:])
    extra = None
    if "--" in argv:                       # everything after -- goes to the runtime untouched
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    args, unknown = p.parse_known_args(argv)
    if args.cmd == "voice":                # 'transcribe --json FILE': argparse leaves FILE unparsed
        args.files = list(args.files or []) + [u for u in (unknown or []) if not u.startswith("-")]
        unknown = [u for u in (unknown or []) if u.startswith("-")]
    if args.cmd in ("run", "show"):
        extra = (unknown or []) + (extra or [])   # unknown flags pass through too
    elif unknown or extra:
        p.error(f"unrecognized arguments: {' '.join((unknown or []) + (extra or []))}")
    args.extra = extra or None

    cfg = load_config()
    if args.cmd is None:
        if not tty():
            p.print_help()
            return 0
        interactive(cfg)
        return 0
    return COMMANDS[args.cmd](args, cfg) or 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except CellError as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print()
        sys.exit(130)
