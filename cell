# --------------------------------------------------------------------------
# cell stays stdlib-only. Recording shells out to parecord / arecord /
# pw-record (raw 16 kHz mono PCM on stdout). Local transcription runs
# faster-whisper inside its own venv (~/.config/cell/voice/venv) through a
# tiny driver sent on stdin; the api engine posts to any OpenAI-compatible
# /audio/transcriptions endpoint with urllib. Nothing here touches a project.

VOICE_DEFAULTS = {
    "engine": "local",            # local (faster-whisper) | api (OpenAI-compatible endpoint)
    "model": "small",             # tiny, base, small, medium, large-v3, turbo, or a HF repo id
    "python": "",                 # interpreter that has faster_whisper; "" = cell's own venv
    "language": "",               # "" = auto-detect, else ISO code: en, hi, de, …
    "beam": 1,                    # 1 = fastest; 5 = faster-whisper's default (slower, a bit better)
    "device": "cpu",              # cpu | cuda
    "compute": "int8",            # int8 on cpu, float16 on cuda
    "silence_seconds": 1.5,       # listen: stop after this much quiet once speech was heard
    "max_seconds": 60,            # listen: hard cap
    "recorder": "auto",           # auto | command writing s16le 16 kHz mono PCM to stdout
    "api_url": "https://api.openai.com/v1",
    "api_model": "whisper-1",
    "api_key_env": "OPENAI_API_KEY",
}
VOICE_RATE = 16000
VOICE_CHUNK = VOICE_RATE // 10 * 2        # 100 ms of s16 mono
VOICE_PIP = ["faster-whisper", "av<19"]   # PyAV 19 broke faster-whisper's audio decoding (metadata_errors)

WHISPER_DRIVER = r'''
