def cmd_doctor(args, cfg):
    """Health check: one command answers 'is everything set up right?'"""
    ok = True

    def bad(msg):
        nonlocal ok
        ok = False
        print(f"  ✗ {msg}")

    print("config")
    if config_path().exists():
        mode = config_path().stat().st_mode & 0o777
        print(f"  ✓ {config_path()}" + ("" if mode == 0o600 or os.name == "nt" else f"  (mode {oct(mode)}, expected 0600)"))
    else:
        bad("no config yet — run 'cell init'")
    print("runtimes")
    runtimes, providers = get_runtimes(cfg), get_providers(cfg)
    for name, rt in sorted(runtimes.items()):
        if which(rt.get("binary", "")):
            print(f"  ✓ {name}: {rt['binary']} found")
        elif any(bp.get("runtime") == name for bp in cfg["blueprints"].values()):
            bad(f"{name}: '{rt['binary']}' not in PATH (cell runtime install {name})")
        else:
            print(f"  - {name}: '{rt['binary']}' not installed (unused)")
    print("blueprints")
    if not cfg["blueprints"]:
        print("  (none — cell add <name>)")
    for name, bp in sorted(cfg["blueprints"].items()):
        rt, prov = runtimes.get(bp.get("runtime")), providers.get(bp.get("provider"))
        if not rt:
            bad(f"{name}: unknown runtime '{bp.get('runtime')}'")
            continue
        if prov is None:
            bad(f"{name}: unknown provider '{bp.get('provider')}' (cell provider add …)")
            continue
        if rt.get("config") == "claude" and bp.get("provider") != "anthropic" and not prov.get("base_url"):
            bad(f"{name}: provider '{bp.get('provider')}' has no Anthropic-compatible endpoint for the claude runtime")
            continue
        key, src = resolve_key(cfg, bp, providers)
        if bp.get("auth") == "login":
            print(f"  ✓ {name}: login (subscription)")
        elif key:
            print(f"  ✓ {name}: key from {src}")
        elif prov.get("login"):
            print(f"  ! {name}: no API key; the runtime will ask you to log in")
        else:
            bad(f"{name}: no API key (cell keys set {bp.get('provider')})")
        if bp.get("persona") and not Path(bp["persona"]).expanduser().is_file() \
                and resolve_template(bp["persona"])[0] is None:
