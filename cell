def interactive(cfg):
    while True:
        cfg = load_config()
        print(f"\n── {APP} v{VERSION} ─────────────────────────────── {Path.cwd()}")
        bps = sorted(cfg.get("blueprints", {}).items())
        here = {i["name"] for i in find_instances(Path.cwd(), get_runtimes(cfg))}
        if not bps:
            print("  (no blueprints yet — press a)")
        for i, (name, bp) in enumerate(bps, 1):
            mark = "•" if name in here else " "
            print(f"  {i} {mark} {name:<14} {bp.get('runtime','')}/{bp.get('provider','')}/{bp.get('model','')}")
        print("\n  <n> run    r resume    c continue    l sessions here    s show")
        print("  a add    e edit    d delete    p providers    k keys    o doctor    q quit")
        print("  (r, c, s, e, d take a number too: r2 = resume blueprint 2)")
        try:
            choice = input("\n> ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        m = re.fullmatch(r"([a-z]?)\s*(\d*)", choice)
        letter, num = (m.group(1), m.group(2)) if m else (choice, "")
        actions = {"": "run", "r": "resume", "c": "continue", "s": "show", "e": "edit", "d": "delete"}
        try:
            if choice in ("q", ""):
                return
            elif choice == "a":
                name = ask("name")
                if name:
                    cmd_add(argparse.Namespace(name=name, runtime=None, provider=None, model=None,
                                               api_key=None, api_key_env=None, login=False,
                                               persona=None, permissions=None, force=False), cfg)
            elif choice == "l":
                cmd_sessions(argparse.Namespace(name=None, limit=10, all=False), cfg)
            elif letter in actions and (num or letter):
                action = actions[letter]
                if not num and len(bps) == 1:
                    num = "1"
                if not num:
                    num = ask(f"blueprint number to {action}")
                idx = int(num) if num.isdigit() else 0
                if not 1 <= idx <= len(bps):
                    print("no such blueprint")
                    continue
                name = bps[idx - 1][0]
                if action in ("run", "resume", "continue"):
                    cmd_run(argparse.Namespace(name=name, resume=True if action == "resume" else None,
                                               cont=action == "continue", prompt=None, model=None,
                                               api_key=None, extra=None, voice=False, cmd="run"), cfg)
                elif action == "show":
                    cmd_show(argparse.Namespace(name=name, resume=None, cont=False, prompt=None,
                                                model=None, api_key=None, extra=None), cfg)
                elif action == "delete":
                    if confirm(f"Delete blueprint '{name}'?"):
                        cmd_remove(argparse.Namespace(name=name), cfg)
                elif action == "edit":
                    print("fields: model, provider, persona, permissions (blank to stop)")
                    ns = argparse.Namespace(name=name, runtime=None, provider=None, model=None,
                                            api_key=None, api_key_env=None, login=False, persona=None,
                                            permissions=None, no_hooks=None, hooks=None)
                    while True:
                        field = ask("field")
                        if field not in ("model", "provider", "persona", "permissions"):
                            break
                        setattr(ns, field, ask(f"new {field}"))
                    cmd_edit(ns, cfg)
            elif choice == "p":
                cmd_provider(argparse.Namespace(action="list", name=None), cfg)
            elif choice == "k":
                cmd_keys(argparse.Namespace(action="list", provider=None, key=None), cfg)
            elif choice == "o":
                cmd_doctor(None, cfg)
            else:
                print("?")
        except CellError as e:
            print(f"error: {e}")


