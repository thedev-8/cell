def _hooks_default(cfg) -> dict:
    return {k: True for k in (cfg.get("hooks") or {})}


def cmd_add(args, cfg):
    name = args.name
    if not valid_name(name):
        raise CellError("name must be lowercase letters, digits, '-' or '_'")
    if name in cfg["blueprints"] and not args.force:
        raise CellError(f"blueprint '{name}' already exists (use --force to replace, or 'cell edit')")
    runtimes, providers = get_runtimes(cfg), get_providers(cfg)
    guided = tty()

    rt_name = args.runtime
    if not rt_name and guided:
        opts = ", ".join(f"{r}{'' if which(rt.get('binary', '')) else ' (not installed)'}"
                         for r, rt in sorted(runtimes.items()))
        rt_name = ask(f"Runtime ({opts})", "claude")
    if not rt_name:
        raise CellError("--runtime is required")
    if rt_name not in runtimes:
        raise CellError(f"unknown runtime '{rt_name}'. Known: {', '.join(sorted(runtimes))}. "
                        f"Add your own with 'cell runtime add'.")
    rt = runtimes[rt_name]

    provider = args.provider
    if not provider and guided:
        provider = ask(f"Provider ({', '.join(sorted(providers))})", "anthropic")
    provider = provider or "anthropic"
    if provider not in providers:
        raise CellError(f"unknown provider '{provider}'. Known: {', '.join(sorted(providers))}. "
                        f"Add your own with: cell provider add {provider} --base-url URL --key-env VAR")
    prov = providers[provider]
    if rt.get("config") == "claude" and provider != "anthropic" and not prov.get("base_url"):
        raise CellError(f"provider '{provider}' has no Anthropic-compatible endpoint, so the "
                        f"claude runtime cannot use it. Either use it with the kimi runtime, or "
                        f"give it a proxy: cell provider add {provider} --base-url http://… --force")

    model = args.model
    if not model and guided:
        model = ask("Model", prov.get("default_model", ""))
    if not model:
        raise CellError("--model is required")

    auth = "login" if args.login else ""
    if auth == "login" and not prov.get("login"):
        raise CellError(f"provider '{provider}' has no subscription login; give it a key instead "
                        f"(cell keys set {provider}, --api-key or --api-key-env)")
    api_key, key_env = args.api_key or "", args.api_key_env or ""
    if not auth and not api_key and not key_env and guided and not prov.get("token"):
        if prov.get("login") and confirm(f"Sign in with your {provider} subscription instead of an API key?"):
            auth = "login"
        elif cfg["keys"].get(provider):
            note(f"using the global key for '{provider}' ({mask(cfg['keys'][provider])})")
        elif os.environ.get(prov.get("key_env", "")):
            note(f"will use ${prov['key_env']} from your environment")
        else:
            api_key = ask_secret(f"API key for {provider} (blank = set later with 'cell keys set {provider}')")
    if auth != "login" and api_key and key_env:
        raise CellError("use either --api-key or --api-key-env, not both")

    persona = args.persona or ""
    if not persona and guided:
        persona = ask(f"Persona: template ({', '.join(template_names())}) or file path, blank = none")
    if persona and not Path(persona).expanduser().is_file() and resolve_template(persona)[0] is None:
        raise CellError(f"persona '{persona}' is not a template or a file")

    permissions = args.permissions or ""
    if not permissions and guided:
        permissions = ask(f"Permissions ({'/'.join(PERMISSION_NAMES)}), blank = runtime default")
    if permissions and permissions not in PERMISSION_NAMES:
        raise CellError(f"permissions must be one of: {', '.join(PERMISSION_NAMES)}")

    bp = {
        "runtime": rt_name,
        "provider": provider,
        "model": model,
        "auth": auth,
        "api_key": api_key,
        "key_env": key_env,
        "persona": persona,
        "permissions": permissions,
        "hooks": _hooks_default(cfg),
    }
    cfg["blueprints"][name] = bp
    save_config(cfg)
    key, src = resolve_key(cfg, bp, providers)
    state = src if (key or auth == "login") else "no key yet"
    print(f"added blueprint '{name}': {rt_name} / {provider} / {model}  [{state}]")
    print(f"next: cd <project> && cell run {name}      (preview first: cell show {name})")


def cmd_edit(args, cfg):
    bp = get_blueprint(cfg, args.name)
    runtimes, providers = get_runtimes(cfg), get_providers(cfg)
    changed = []
    if args.runtime is not None:
        if args.runtime not in runtimes:
            raise CellError(f"unknown runtime '{args.runtime}'. Known: {', '.join(sorted(runtimes))}")
        bp["runtime"] = args.runtime
        changed.append("runtime")
    if args.provider is not None:
        if args.provider not in providers:
            raise CellError(f"unknown provider '{args.provider}'. Known: {', '.join(sorted(providers))}")
        bp["provider"] = args.provider
        changed.append("provider")
        if bp.get("auth") == "login" and not providers[args.provider].get("login"):
            bp["auth"] = ""
            note(f"'{args.provider}' has no subscription login: auth reset to key "
                 f"(cell keys set {args.provider})")
    if args.model is not None:
        if not args.model:
            raise CellError("model cannot be empty")
        bp["model"] = args.model
        changed.append("model")
    if args.api_key is not None:
        bp["api_key"] = args.api_key
        if args.api_key:
            bp["auth"], bp["key_env"] = "", ""
        changed.append("api_key")
    if args.api_key_env is not None:
        bp["key_env"] = args.api_key_env
        if args.api_key_env:
            bp["auth"], bp["api_key"] = "", ""
        changed.append("key_env")
    if args.login:
        if not providers.get(bp.get("provider"), {}).get("login"):
            raise CellError(f"provider '{bp.get('provider')}' has no subscription login")
        bp["auth"], bp["api_key"], bp["key_env"] = "login", "", ""
        changed.append("auth=login")
    if args.persona is not None:
        if args.persona and not Path(args.persona).expanduser().is_file() \
                and resolve_template(args.persona)[0] is None:
            raise CellError(f"persona '{args.persona}' is not a template or a file")
        bp["persona"] = args.persona
        changed.append("persona")
    if args.permissions is not None:
        if args.permissions and args.permissions not in PERMISSION_NAMES:
            raise CellError(f"permissions must be one of: {', '.join(PERMISSION_NAMES)} (or '' to clear)")
        bp["permissions"] = args.permissions
        changed.append("permissions")
    hooks = dict(bp.get("hooks") or {})
    for h in (cfg.get("hooks") or {}):
        hooks.setdefault(h, True)
    if args.no_hooks is not None:
        for h in (args.no_hooks or list(hooks)):
            hooks[h] = False
        changed.append("hooks")
    if args.hooks is not None:
        for h in (args.hooks or list(hooks)):
            hooks[h] = True
        changed.append("hooks")
    bp["hooks"] = hooks
    if not changed:
        raise CellError("nothing to change — see 'cell edit --help'")
    save_config(cfg)
    print(f"updated '{args.name}': {', '.join(changed)}  (applies on next 'cell run')")


def cmd_list(args, cfg):
    bps = cfg.get("blueprints", {})
    if not bps:
        print("no blueprints yet — create one with: cell add <name>")
        return
    providers = get_providers(cfg)
    for name, bp in sorted(bps.items()):
        key, src = resolve_key(cfg, bp, providers)
        if bp.get("auth") == "login":
            state = "login"
        elif key:
            state = "key: " + src
        elif providers.get(bp.get("provider"), {}).get("login"):
            state = "login (no key; runtime signs in)"
        else:
            state = "NO KEY"
        print(f"  {name:<16} {bp.get('runtime',''):<8} {bp.get('provider','')}/{bp.get('model','')}"
              f"  [{state}]")


def cmd_remove(args, cfg):
    get_blueprint(cfg, args.name)
    del cfg["blueprints"][args.name]
    save_config(cfg)
    print(f"removed blueprint '{args.name}' (instance dirs stay; 'cell clean {args.name}' deletes them)")


def _pick_blueprint(args, cfg) -> str:
    bps = sorted(cfg.get("blueprints", {}))
    if not bps:
        raise CellError("no blueprints defined. Use 'cell add' first.")
    resume = getattr(args, "resume", None)
    if not args.name and isinstance(resume, str) and resume in bps:
        # `cell run -r max`: -r takes an optional session ID and swallowed the name
        args.name, args.resume = resume, True
    if args.name:
        if args.name not in bps:
            raise CellError(f"no blueprint '{args.name}'. Known: {', '.join(bps)}")
        return args.name
    here = sorted({i["name"] for i in find_instances(Path.cwd(), get_runtimes(cfg))} & set(bps))
    if len(here) == 1:
        return here[0]
    if len(bps) == 1:
        return bps[0]
    verb = getattr(args, "cmd", None) or "run"
    pool = here or bps
    hint = "each has an env dir here" if here else "no env dir here yet"
    raise CellError(f"which blueprint? {', '.join(pool)} ({hint}). "
                    f"Put the name first: cell {verb} {pool[0]} [-r|-c|-p ...]")


def _print_plan(plan, cmd, env, fresh_note=True):
    rt, env_dir = plan["rt"], plan["env_dir"]
    print(f"blueprint    {plan['name']}")
    print(f"runtime      {plan['runtime']} ({rt['binary']}: {which(rt['binary']) or 'NOT FOUND'})")
    print(f"provider     {plan['provider']}  {plan['prov'].get('base_url') or '(first-party)'}")
    print(f"model        {plan['model'] or '(runtime default)'}")
    if plan["permissions"]:
        print(f"permissions  {plan['permissions']}")
    if plan["persona"]:
        print(f"persona      {plan['persona']}")
    print(f"env dir      {env_dir}{'' if env_dir.exists() else '  (will be created)'}")
    print(f"auth         {'login (runtime signs in itself)' if plan['auth'] == 'login' else (mask(plan['key']) + '  from ' + str(plan['key_src']) if plan['key'] else 'NO KEY')}")
    if plan["settings_env"]:
        print("settings.json env:")
        for k, v in plan["settings_env"].items():
            print(f"    {k}={v}")
    print("process env:")
    print(f"    {rt['env_var']}={env_dir}")
    for k, v in plan["process_env"].items():
        print(f"    {k}={mask(v)}")
    for k in plan["drop_env"]:
        if k in os.environ:
            print(f"    unset {k}  (was set in your shell)")
    print(f"command      {' '.join(cmd)}")
    for w in plan["warnings"]:
        warn(w)


def cmd_show(args, cfg):
    """Dry-run: print exactly what would happen, secrets masked."""
    name = _pick_blueprint(args, cfg)
    plan = build_plan(cfg, name, Path.cwd(), api_key_flag=args.api_key)
    cmd, env = launch_command(plan, args.prompt, args.resume, args.cont, args.model, args.extra)
    _print_plan(plan, cmd, env)
    if plan["rt"].get("config") == "claude":
        existing = load_settings(plan["env_dir"]) if plan["env_dir"].exists() else {}
        new, _ = planned_settings(plan, cfg, existing, read_meta(plan["env_dir"]))
        if new != existing:
            print("settings.json changes:")
            for k in sorted(set(existing) | set(new)):
                if existing.get(k) != new.get(k):
                    print(f"    {k}: {json.dumps(existing.get(k))[:60]} -> {json.dumps(new.get(k))[:60]}")


def cmd_run(args, cfg):
    name = _pick_blueprint(args, cfg)
    cwd = Path.cwd()
    plan = build_plan(cfg, name, cwd, api_key_flag=args.api_key)
    binary = plan["rt"]["binary"]
    if not which(binary):
        raise CellError(f"'{binary}' is not installed or not in PATH. "
                        f"Try: cell runtime install {plan['runtime']}")
    prompt, extra = args.prompt, list(args.extra or [])
    if getattr(args, "voice", False):
        spoken = voice_capture_text(cfg)
        print(f"you said: {spoken}")
        if prompt:
            prompt = f"{prompt}\n\n{spoken}"
        else:
            extra.insert(0, spoken)           # positional prompt: the session opens with it
    if prompt and not plan["rt"].get("prompt_flag"):
        note(f"runtime '{plan['runtime']}' has no prompt flag configured; passing the prompt as a plain argument")
        extra.append(prompt)
        prompt = None
    if args.resume is not None and not plan["rt"].get("resume_flag"):
        note(f"runtime '{plan['runtime']}' has no resume flag configured; ignoring --resume")
    if args.cont and not plan["rt"].get("continue_flag"):
        note(f"runtime '{plan['runtime']}' has no continue flag configured; ignoring --continue")
    fresh, copied = write_instance(plan, cfg, cwd)
    cmd, env = launch_command(plan, prompt, args.resume, args.cont, args.model, extra)
    for w in plan["warnings"]:
        warn(w)
    if fresh:
        print(f"created {plan['env_dir']}" + (f" (+{len(copied)} seed files)" if copied else ""))
        if plan["auth"] == "login":
            note(f"first launch: {binary} will ask you to log in; that login stays private to this env dir")
    else:
        print(f"→ {plan['env_dir']}")
    sys.stdout.flush()
    exec_runtime(cmd, env)


def exec_runtime(cmd, env):
    """Hand the terminal over to the runtime. On POSIX we *replace* this
    process (like `exec` in a shell): Ctrl-C then reaches only the runtime,
    which handles it itself. A wrapper that merely waits would get the same
    SIGINT and kill its child."""
    path = which(cmd[0])
    if path:
        cmd[0] = path
    if os.name != "nt" and hasattr(os, "execvpe"):
        try:
            os.execvpe(cmd[0], cmd, env)
        except OSError as e:
            raise CellError(f"could not launch '{cmd[0]}': {e}")
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        p = subprocess.Popen(cmd, env=env)
    except OSError as e:
        raise CellError(f"could not launch '{cmd[0]}': {e}")
    while True:
        try:
            sys.exit(p.wait())
        except KeyboardInterrupt:
            continue


