    if cfg.get("hooks"):
        print("hooks")
        for ev, cmd in sorted(cfg["hooks"].items()):
            if not isinstance(cmd, str) or not cmd:
                continue
            missing = sorted({w for w in re.findall(r"(?<![\w/.$-])(python3?|node|bun|deno|perl|ruby)(?=\s)", cmd)
                              if not which(w)})
            if missing:
                hint = "  (use python3)" if "python" in missing and which("python3") else ""
                bad(f"{ev}: calls {', '.join(repr(m) for m in missing)} but it is not in PATH{hint}")
            else:
                print(f"  ✓ {ev}")
    if cfg.get("voice"):
        print("voice")
        vc = voice_cfg(cfg)
        if vc["engine"] == "local":
            py = voice_python(vc)
            if py.exists() and subprocess.run([str(py), "-c", "import faster_whisper"], capture_output=True).returncode == 0:
                mdir = voice_dir() / "models"
                cached = mdir.is_dir() and any(p.name.endswith(f"-{vc['model']}") for p in mdir.glob("models--*"))
                print(f"  ✓ engine local: faster-whisper, model {vc['model']}"
                      + ("" if cached else "  (not downloaded yet: cell voice setup)"))
            else:
                bad(f"engine local: faster_whisper missing in {py} (cell voice setup)")
        elif voice_api_key(cfg, vc):
            print(f"  ✓ engine api: {vc['api_url']} ({vc['api_model']})")
        else:
            bad(f"engine api: no key — export {vc['api_key_env']} or 'cell keys set voice'")
        _, rec = find_recorder(vc)
        if rec:
            print(f"  ✓ recorder: {rec}")
        else:
            bad("no recorder: install pulseaudio-utils (parecord), alsa-utils (arecord) or pipewire")
        skill = seed_dir("claude") / "skills" / "voice" / "SKILL.md"
        if skill.is_file():
            print("  ✓ /voice skill seeded for claude envs")
        else:
            bad("/voice skill missing (cell voice setup)")
    print("instances (this project)")
    cwd = Path.cwd()
    insts = find_instances(cwd, runtimes)
    for inst in insts:
        known = inst["name"] in cfg["blueprints"]
        print(f"  {'✓' if known else '!'} {inst['path'].name}" + ("" if known else "  orphaned (no blueprint; cell clean " + inst["name"] + ")"))
        if (inst["path"] / SETTINGS_FILE).exists():
            try:
                json.loads((inst["path"] / SETTINGS_FILE).read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError):
                bad(f"{inst['path'].name}/settings.json is not valid JSON")
    if not insts:
        print("  (none)")
    if (cwd / ".git").is_dir() and insts:
        try:
            r = subprocess.run(["git", "-C", str(cwd), "ls-files"] + [i["path"].name for i in insts],
                               capture_output=True, text=True, timeout=10)
            tracked = sorted({line.split("/", 1)[0] for line in r.stdout.splitlines() if line})
            if tracked:
                bad(f"committed to git (contain credentials!): {', '.join(tracked)}  "
                    f"-> git rm -r --cached {' '.join(tracked)}")
            else:
                print("  ✓ none tracked by git")
        except (OSError, subprocess.SubprocessError):
            pass
    print("ok" if ok else "problems found")
    return 0 if ok else 1


