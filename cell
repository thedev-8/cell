EPILOG = """
examples:
  cell add max --runtime claude --provider anthropic --model opus --login
  cell add glm --runtime claude --provider zai --model glm-5.3 && cell keys set zai
  cell provider add myproxy --base-url http://localhost:4000 --key-env MYPROXY_KEY
  cell run max                 # in a project dir: creates ./.claude-env-max/ and launches
  cell run glm -p "explain this repo"
  cell show glm                # dry-run: files, env and command, secrets masked
  cell import                  # bring your helo blueprints over
"""


def build_parser():
    p = argparse.ArgumentParser(prog=APP, description=__doc__, epilog=EPILOG, allow_abbrev=False,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    sp = sub.add_parser("add", help="create a blueprint (an agent identity)")
    sp.add_argument("name")
    sp.add_argument("--runtime", help="claude, kimi, or one added with 'cell runtime add'")
    sp.add_argument("--provider", help="LLM subscription: see 'cell provider list'")
    sp.add_argument("--model", help="model id or alias, e.g. opus, glm-5.3, kimi-code/k3")
    sp.add_argument("--api-key", help="key stored in the blueprint (prefer 'cell keys set' or --api-key-env)")
    sp.add_argument("--api-key-env", metavar="VAR", help="read the key from this env var at launch (never stored)")
    sp.add_argument("--login", action="store_true", help="no key: the runtime signs in with your subscription")
    sp.add_argument("--persona", help="template name (cell templates list) or a file path")
    sp.add_argument("--permissions", choices=PERMISSION_NAMES, help="bypass = never ask (claude: bypassPermissions, kimi: --auto)")
    sp.add_argument("--force", action="store_true", help="replace an existing blueprint")

    sp = sub.add_parser("edit", help="change blueprint fields ('' clears a field)")
    sp.add_argument("name")
    sp.add_argument("--runtime")
    sp.add_argument("--provider")
    sp.add_argument("--model")
    sp.add_argument("--api-key")
    sp.add_argument("--api-key-env", metavar="VAR")
