def _pick_blueprint(args, cfg) -> str:
    """Which blueprint 'run'/'show' means: the one named, else the only one
    with an env dir here (or that owns the -r session id), else the only
    blueprint at all, else ask (in a terminal) or explain how to name it."""
    bps = sorted(cfg.get("blueprints", {}))
    if not bps:
        raise CellError("no blueprints yet. Create one: cell add NAME   (or type 'cell' for the menu)")
    resume = getattr(args, "resume", None)
    if not args.name and isinstance(resume, str):
        try:    # `cell run -r max`: -r takes an optional session ID and swallowed the name
            args.name, args.resume = resolve_blueprint(cfg, resume), True
        except CellError:
            pass
    if args.name:
        args.name = resolve_blueprint(cfg, args.name)
        return args.name
    runtimes = get_runtimes(cfg)
    insts = [i for i in find_instances(Path.cwd(), runtimes) if i["name"] in bps]
    here = sorted({i["name"] for i in insts})
    if isinstance(args.resume, str):
        owners = sorted({i["name"] for i in insts if find_session_ids(i, runtimes, args.resume)})
        if len(owners) == 1:
            return owners[0]
    if len(here) == 1:
        return here[0]
    if len(bps) == 1:
        return bps[0]
    verb = getattr(args, "cmd", None) or "run"
    if tty():
        print("which blueprint?   (• = has an env dir in this folder)")
        for n, b in enumerate(bps, 1):
            bp = cfg["blueprints"][b]
            print(f"  {n} {'•' if b in here else ' '} {b:<14} {bp.get('runtime', '')}/{bp.get('provider', '')}/{bp.get('model', '')}")
        pick = ask("number (Enter = cancel)")
        if pick.isdigit() and 1 <= int(pick) <= len(bps):
            return bps[int(pick) - 1]
        raise CellError(f"cancelled. Next time name it: {run_hint(bps[0]) if verb == 'run' else f'cell {verb} {bps[0]}'}")
    where = f" (env dirs here: {', '.join(here)})" if here else ""
    first = (here or bps)[0]
    example = run_hint(first) if verb == "run" else f"cell {verb} {first}"
    raise CellError(f"which blueprint? {', '.join(bps)}{where}. "
                    f"Name it first: {example} [-r|-c|-p ...]")


