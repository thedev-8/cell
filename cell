def cmd_run(args, cfg):
    name = _pick_blueprint(args, cfg)
    cwd = Path.cwd()
    plan = build_plan(cfg, name, cwd, api_key_flag=args.api_key)
    if plan["fatal"]:
        raise CellError(plan["fatal"])
    binary = plan["rt"]["binary"]
    if not which(binary):
        raise CellError(f"'{binary}' is not installed or not in PATH. "
                        f"Try: cell runtime install {plan['runtime']}")
    prompt, extra = args.prompt, list(args.extra or [])
    if getattr(args, "voice", False):
        spoken = voice_capture_text(cfg)
        print(f"you said: {spoken}")
        if prompt:
            prompt = f"{prompt}\n\n{spoken}"
        else:
            extra.insert(0, spoken)           # positional prompt: the session opens with it
    if prompt and not plan["rt"].get("prompt_flag"):
        note(f"runtime '{plan['runtime']}' has no prompt flag configured; passing the prompt as a plain argument")
        extra.append(prompt)
        prompt = None
    if args.resume is not None and not plan["rt"].get("resume_flag"):
        note(f"runtime '{plan['runtime']}' has no resume flag configured; ignoring --resume")
    if args.cont and not plan["rt"].get("continue_flag"):
        note(f"runtime '{plan['runtime']}' has no continue flag configured; ignoring --continue")
    resume = resolve_session(plan, cfg, args.resume)
    fresh, copied = write_instance(plan, cfg, cwd)
    ensure_plugins(plan, cfg)
    cmd, env = launch_command(plan, prompt, resume, args.cont, args.model, extra)
    for w in plan["warnings"]:
        warn(w)
    if fresh:
        print(f"created {plan['env_dir']}" + (f" (+{len(copied)} seed files)" if copied else ""))
        if plan["auth"] == "login":
            note(f"first launch: {binary} will ask you to log in; that login stays private to this env dir")
    else:
        print(f"→ {plan['env_dir']}")
    unseen = learn_state().get("unseen", 0) if plan["rt"].get("config") == "claude" else 0
    if unseen:
        note(f"learned {unseen} new rule(s) from your recent sessions — review: cell learn")
    sys.stdout.flush()
    exec_runtime(cmd, env)


def exec_runtime(cmd, env):
    """Hand the terminal over to the runtime. On POSIX we *replace* this
    process (like `exec` in a shell): Ctrl-C then reaches only the runtime,
    which handles it itself. A wrapper that merely waits would get the same
    SIGINT and kill its child."""
    path = which(cmd[0])
    if path:
        cmd[0] = path
    if os.name != "nt" and hasattr(os, "execvpe"):
        try:
            os.execvpe(cmd[0], cmd, env)
        except OSError as e:
            raise CellError(f"could not launch '{cmd[0]}': {e}")
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        p = subprocess.Popen(cmd, env=env)
    except OSError as e:
        raise CellError(f"could not launch '{cmd[0]}': {e}")
    while True:
        try:
            sys.exit(p.wait())
        except KeyboardInterrupt:
            continue


