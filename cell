def cmd_edit(args, cfg):
    args.name = resolve_blueprint(cfg, args.name)
    bp = cfg["blueprints"][args.name]
    runtimes, providers = get_runtimes(cfg), get_providers(cfg)
    changed = []
    if args.runtime is not None:
        if args.runtime not in runtimes:
            raise CellError(f"unknown runtime '{args.runtime}'.{suggest(args.runtime, runtimes)} "
                            f"Known: {', '.join(sorted(runtimes))}")
        bp["runtime"] = args.runtime
        changed.append("runtime")
    if args.provider is not None:
        if args.provider not in providers:
            raise CellError(f"unknown provider '{args.provider}'.{suggest(args.provider, providers)} "
                            f"Known: {', '.join(sorted(providers))}")
        bp["provider"] = args.provider
        changed.append("provider")
        if bp.get("auth") == "login" and not providers[args.provider].get("login"):
            bp["auth"] = ""
            note(f"'{args.provider}' has no subscription login: auth reset to key "
                 f"(cell keys set {args.provider})")
    if args.model is not None:
        if not args.model:
            raise CellError("model cannot be empty")
        bp["model"] = args.model
        changed.append("model")
    if args.api_key is not None:
        bp["api_key"] = args.api_key
        if args.api_key:
            bp["auth"], bp["key_env"] = "", ""
        changed.append("api_key")
    if args.api_key_env is not None:
        bp["key_env"] = args.api_key_env
        if args.api_key_env:
            bp["auth"], bp["api_key"] = "", ""
        changed.append("key_env")
    if args.login:
        if not providers.get(bp.get("provider"), {}).get("login"):
            raise CellError(f"provider '{bp.get('provider')}' has no subscription login")
        bp["auth"], bp["api_key"], bp["key_env"] = "login", "", ""
        changed.append("auth=login")
    if args.persona is not None:
        if args.persona and not Path(args.persona).expanduser().is_file() \
                and resolve_template(args.persona)[0] is None:
            raise CellError(f"persona '{args.persona}' is not a template or a file")
        bp["persona"] = args.persona
        changed.append("persona")
    if args.permissions is not None:
        if args.permissions and args.permissions not in PERMISSION_NAMES:
            raise CellError(f"permissions must be one of: {', '.join(PERMISSION_NAMES)} (or '' to clear)")
        bp["permissions"] = args.permissions
        changed.append("permissions")
    configured = list(cfg.get("hooks") or {})
    hooks = {h: v for h, v in (bp.get("hooks") or {}).items() if h in configured}
    for h in configured:
        hooks.setdefault(h, True)
    for flag, value in ((args.no_hooks, False), (args.hooks, True)):
        if flag is None:
            continue
        names = [hook_key(h) for h in flag] or configured
        bad = [h for h in names if h not in configured]
        if bad:
            raise CellError(f"no hook '{bad[0]}'.{suggest(bad[0], configured)} "
                            f"Configured: {', '.join(configured) or 'none (cell hooks set …)'}")
        for h in names:
            hooks[h] = value
        changed.append(f"hooks ({', '.join(h + (' on' if value else ' off') for h in names)})")
    bp["hooks"] = hooks
    if not changed:
        describe_blueprint(args.name, bp, cfg)
        print(f"\nchange with: cell edit {args.name} --model M | --provider P | --runtime R | --persona T|FILE\n"
              f"             --permissions {'|'.join(PERMISSION_NAMES)} ('' clears) | --login | --api-key-env VAR\n"
              f"             --no-hooks [EVENT…] | --hooks [EVENT…]")
        return
    rt, prov = runtimes.get(bp.get("runtime")) or {}, providers.get(bp.get("provider")) or {}
    if rt.get("config") == "claude" and bp.get("provider") != "anthropic" and not prov.get("base_url"):
        raise CellError(f"the claude runtime cannot use provider '{bp.get('provider')}' (no Anthropic-compatible "
                        f"endpoint). Use --runtime kimi, or give it a proxy: "
                        f"cell provider add {bp.get('provider')} --base-url http://… --force")
    save_config(cfg)
    print(f"updated '{args.name}': {', '.join(changed)}  (applies on next 'cell run')")


