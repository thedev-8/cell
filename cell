def mask(key) -> str:
    """Mask a secret for display. Never reveals more than 6 characters."""
    if not key:
        return "(none)"
    key = str(key)
    if len(key) <= 8:
        return "••••"
    return f"{key[:4]}…{key[-2:]}"


def warn(msg: str):
    print(f"warning: {msg}", file=sys.stderr)


def note(msg: str):
    print(f"note: {msg}")


def tty() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def confirm(prompt: str, assume_yes: bool = False) -> bool:
    if assume_yes:
        return True
    if not tty():
        warn("not a terminal; refusing without --yes")
        return False
    try:
        return input(f"{prompt} [y/N] ").strip().lower() in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def ask(prompt: str, default: str = "") -> str:
    """Prompt with an optional default; EOF/Ctrl-C return the default."""
    try:
        v = input(f"{prompt}{f' [{default}]' if default else ''}: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return default
    return v or default


def ask_secret(prompt: str) -> str:
    try:
        return getpass.getpass(f"{prompt}: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return ""


def which(binary: str):
    return shutil.which(binary) or (shutil.which(binary + ".exe") if os.name == "nt" else None)


def camel(event: str) -> str:
    """stop -> Stop, user_prompt_submit -> UserPromptSubmit, PostCompact -> PostCompact"""
    if "_" not in event and event[:1].isupper():
        return event
    return "".join(w.capitalize() for w in event.split("_"))


def valid_name(name: str) -> bool:
    return bool(re.fullmatch(r"[a-z0-9][a-z0-9_-]*", name))


def instance_dir(cwd: Path, runtime: str, name: str) -> Path:
    return cwd / f".{runtime}-env-{name}"


def find_instances(cwd: Path, runtimes=None):
    """Every '.<runtime>-env-<name>' dir in the project. Known runtime names
    are matched first so a runtime called 'gemini-cli' is split correctly."""
    found = []
    if not cwd.is_dir():
        return found
    names = sorted(runtimes or [], key=len, reverse=True)
    for d in sorted(cwd.iterdir()):
        if not d.is_dir() or not d.name.startswith("."):
            continue
        rt = name = None
        for r in names:
            if d.name.startswith(f".{r}-env-") and len(d.name) > len(r) + 6:
                rt, name = r, d.name[len(r) + 6:]
                break
        if rt is None:
            m = re.match(r"^\.([A-Za-z0-9_-]+?)-env-(.+)$", d.name)
            if not m:
                continue
            rt, name = m.group(1), m.group(2)
        found.append({"runtime": rt, "name": name, "path": d})
    return found


def read_meta(env_dir: Path) -> dict:
    p = env_dir / META_FILE
    if not p.exists():
        return {}
    try:
        with open(p, "rb") as f:
            return tomllib.load(f)
    except (tomllib.TOMLDecodeError, OSError):
        return {}


def resolve_template(name: str):
    """Persona template -> (text, source). Files in ~/.config/cell/templates/
    win over the built-in one-liners."""
    for cand in (templates_dir() / f"{name}.md", templates_dir() / name):
        if cand.is_file():
            return cand.read_text(encoding="utf-8"), str(cand)
    if name in PERSONAS:
        return PERSONAS[name], "built-in"
    return None, None


def template_names() -> list:
    names = set(PERSONAS)
    if templates_dir().is_dir():
        names.update(p.stem for p in templates_dir().glob("*.md"))
    return sorted(names)


