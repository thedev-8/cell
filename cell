# --------------------------------------------------------------------------
# Tiny TOML writer (stdlib only has a reader). Handles the shape this
# program writes: nested tables, scalars, and lists of scalars.
# --------------------------------------------------------------------------

_BARE_KEY = re.compile(r"^[A-Za-z0-9_-]+$")


def _toml_key(k: str) -> str:
    return k if _BARE_KEY.match(k) else json.dumps(k)


def _toml_scalar(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, (list, tuple)):
        return "[" + ", ".join(_toml_scalar(x) for x in v) + "]"
    return json.dumps(str(v))


def _dump_toml(data: dict, prefix: str, out: list):
    scalars = [(k, v) for k, v in data.items() if v is not None and not isinstance(v, dict)]
    tables = [(k, v) for k, v in data.items() if isinstance(v, dict)]
    if prefix and (scalars or not tables):
        out.append(f"[{prefix}]")
    for k, v in scalars:
        out.append(f"{_toml_key(k)} = {_toml_scalar(v)}")
    if scalars:
        out.append("")
    for k, v in tables:
        _dump_toml(v, f"{prefix}.{_toml_key(k)}" if prefix else _toml_key(k), out)


def dumps_toml(data: dict) -> str:
    out: list = []
    _dump_toml(data, "", out)
    text = "\n".join(out).strip() + "\n"
    return re.sub(r"\n{3,}", "\n\n", text)


