    "add": cmd_add, "edit": cmd_edit, "list": cmd_list, "remove": cmd_remove,
    "run": cmd_run, "show": cmd_show, "status": cmd_status, "doctor": cmd_doctor,
    "keys": cmd_keys, "key": cmd_key, "provider": cmd_provider, "runtime": cmd_runtime,
    "hooks": cmd_hooks, "templates": cmd_templates, "sessions": cmd_sessions,
    "clean": cmd_clean, "import": cmd_import, "init": cmd_init, "voice": cmd_voice,
}


def main():
    p = build_parser()
    argv = sys.argv[1:]
    extra = None
    if "--" in argv:                       # everything after -- goes to the runtime untouched
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    args, unknown = p.parse_known_args(argv)
    if args.cmd == "voice":                # 'transcribe --json FILE': argparse leaves FILE unparsed
        args.files = list(args.files or []) + [u for u in (unknown or []) if not u.startswith("-")]
        unknown = [u for u in (unknown or []) if u.startswith("-")]
    if args.cmd in ("run", "show"):
        extra = (unknown or []) + (extra or [])   # unknown flags pass through too
    elif unknown or extra:
        p.error(f"unrecognized arguments: {' '.join((unknown or []) + (extra or []))}")
    args.extra = extra or None

    cfg = load_config()
    if args.cmd is None:
        if not tty():
            p.print_help()
            return 0
        interactive(cfg)
        return 0
    return COMMANDS[args.cmd](args, cfg) or 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except CellError as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print()
        sys.exit(130)
