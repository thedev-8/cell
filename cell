def config_dir() -> Path:
    override = os.environ.get("CELL_HOME")
    if override:
        return Path(override).expanduser()
    xdg = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(xdg) / APP


def config_path() -> Path:
    return config_dir() / "config.toml"


def seed_dir(runtime: str) -> Path:
    """Files under ~/.config/cell/seed/<runtime>/ are copied into every new
    instance dir of that runtime (never overwriting). Use it for hook
    scripts, a settings.json baseline, or anything a runtime expects."""
    return config_dir() / "seed" / runtime


def templates_dir() -> Path:
    return config_dir() / "templates"


