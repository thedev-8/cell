def _hooks_default(cfg) -> dict:
    return {k: True for k in (cfg.get("hooks") or {})}


def cmd_add(args, cfg):
    name = args.name
    if not valid_name(name):
        raise CellError("name must be lowercase letters, digits, '-' or '_'")
    if name in cfg["blueprints"] and not args.force:
        raise CellError(f"blueprint '{name}' already exists (use --force to replace, or 'cell edit')")
    runtimes, providers = get_runtimes(cfg), get_providers(cfg)
    guided = tty()

    rt_name = args.runtime
    if not rt_name and guided:
        opts = ", ".join(f"{r}{'' if which(rt.get('binary', '')) else ' (not installed)'}"
                         for r, rt in sorted(runtimes.items()))
        rt_name = ask_choice(f"Runtime ({opts})", runtimes, "claude")
    if not rt_name:
        # claude, unless the provider can only work in kimi (kimi, openai)
        p0 = args.provider or "anthropic"
        rt_name = "claude" if (p0 == "anthropic" or providers.get(p0, {}).get("base_url")
                               or "kimi" not in runtimes) else "kimi"
        note(f"runtime: {rt_name} (default; --runtime to choose)")
    if rt_name not in runtimes:
        raise CellError(f"unknown runtime '{rt_name}'.{suggest(rt_name, runtimes)} Known: {', '.join(sorted(runtimes))}. "
                        f"Add your own with 'cell runtime add'.")
    rt = runtimes[rt_name]

    provider = args.provider
    if not provider and guided:
        provider = ask_choice(f"Provider ({', '.join(sorted(providers))})", providers,
                              "kimi" if rt_name == "kimi" and "kimi" in providers else "anthropic")
    provider = provider or "anthropic"
    if provider not in providers:
        raise CellError(f"unknown provider '{provider}'.{suggest(provider, providers)} Known: {', '.join(sorted(providers))}. "
                        f"Add your own with: cell provider add {provider} --base-url URL --key-env VAR")
    prov = providers[provider]
    if rt.get("config") == "claude" and provider != "anthropic" and not prov.get("base_url"):
        raise CellError(f"provider '{provider}' has no Anthropic-compatible endpoint, so the "
                        f"claude runtime cannot use it. Either use it with the kimi runtime, or "
                        f"give it a proxy: cell provider add {provider} --base-url http://… --force")

    model = args.model
    if not model and guided:
        model = ask("Model", prov.get("default_model", ""))
    if not model and prov.get("default_model"):
        model = prov["default_model"]
        note(f"model: {model} (provider default; --model to choose)")
    if not model:
        raise CellError("--model is required")

    auth = "login" if args.login else ""
    if auth == "login" and not prov.get("login"):
        raise CellError(f"provider '{provider}' has no subscription login; give it a key instead "
                        f"(cell keys set {provider}, --api-key or --api-key-env)")
    api_key, key_env = args.api_key or "", args.api_key_env or ""
    if not auth and not api_key and not key_env and guided and not prov.get("token"):
        if prov.get("login") and confirm(f"Sign in with your {provider} subscription instead of an API key?"):
            auth = "login"
        elif cfg["keys"].get(provider):
            note(f"using the global key for '{provider}' ({mask(cfg['keys'][provider])})")
        elif os.environ.get(prov.get("key_env", "")):
            note(f"will use ${prov['key_env']} from your environment")
        else:
            api_key = ask_secret(f"API key for {provider} (blank = set later with 'cell keys set {provider}')")
    if auth != "login" and api_key and key_env:
        raise CellError("use either --api-key or --api-key-env, not both")

    def persona_ok(p):
        return not p or Path(p).expanduser().is_file() or resolve_template(p)[0] is not None

    persona = args.persona or ""
    while not persona and guided:
        persona = ask(f"Persona: template ({', '.join(template_names())}) or file path, blank = none")
        if persona_ok(persona):
            break
        print(f"  '{persona}' is not a template or an existing file")
        persona = ""
    if not persona_ok(persona):
        raise CellError(f"persona '{persona}' is not a template ({', '.join(template_names())}) or an existing file")

    permissions = args.permissions or ""
