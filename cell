def cmd_sessions(args, cfg):
    """Sessions started in this folder, newest first, with a short id and a
    title. In a terminal, type a number to open that session."""
    cwd = Path.cwd()
    runtimes = get_runtimes(cfg)
    instances = find_instances(cwd, runtimes)
    if args.name:
        want = args.name.lower()
        names = sorted({i["name"] for i in instances})
        instances = [i for i in instances if i["name"].lower() == want]
        if not instances:
            raise CellError(f"no env dir for '{args.name}' in this folder.{suggest(args.name, names)} "
                            f"Here: {', '.join(names) or 'none'}")
    width = shutil.get_terminal_size((100, 24)).columns
    rows, here_rows, hidden = [], [], 0
    for inst in instances:
        sessions = list_sessions(inst, runtimes, cwd)
        if sessions is None:                     # custom runtime: show its newest log files
            files = sorted(inst["path"].rglob("*.jsonl"), key=lambda f: f.stat().st_mtime, reverse=True)
            if files:
                print(f"{inst['name']} ({inst['runtime']}): session layout unknown, newest logs:")
                for f in files[:args.limit]:
                    ts = datetime.datetime.fromtimestamp(f.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
                    print(f"        {ts}  {f.relative_to(inst['path'])}")
            continue
        if not args.all:
            hidden += sum(1 for s in sessions if not s["here"])
            sessions = [s for s in sessions if s["here"]]
        if not sessions:
            continue
        print(f"{inst['name']} ({inst['runtime']})")
        for s in sessions[:args.limit]:
            rows.append((inst["name"], s["id"]))
            if s["here"]:
                here_rows.append(rows[-1])
            when = datetime.datetime.fromtimestamp(s["mtime"]).strftime("%Y-%m-%d %H:%M")
            head = f"  {len(rows):>3}  {when}  {short_id(s['id'])}  "
            text = session_title(s) + ("" if s["here"] else "  [other folder]")
            room = max(20, width - len(head) - 1)
            print(head + (text if len(text) <= room else text[:room - 1] + "…"))
        if len(sessions) > args.limit:
            print(f"       … {len(sessions) - args.limit} older: cell sessions {inst['name']} -n {len(sessions)}")
    if hidden and not args.all:
        print(f"({hidden} more started in other folders: cell sessions --all)")
    if not rows:
        print("no sessions in this folder yet" if instances else
              "no env dirs in this folder yet: start one with  cell run NAME")
        return
    name, sid = (here_rows or rows)[0]
    print(f"\nopen one:  cell {name} -r {short_id(sid)}      latest:  cell {name} -c")
    if not tty():
        return
    pick = ask("open # (Enter = quit)")
    if not pick:
        return
    if not pick.isdigit() or not 1 <= int(pick) <= len(rows):
        raise CellError(f"no session #{pick}")
    name, sid = rows[int(pick) - 1]
    if name not in cfg["blueprints"]:
        raise CellError(f"'{name}' has an env dir here but no blueprint (cell add {name} …)")
    return cmd_run(argparse.Namespace(name=name, resume=sid, cont=False, prompt=None, model=None,
                                      api_key=None, extra=None, voice=False, cmd="run"), cfg)


