    print("instances (this project)")
    cwd = Path.cwd()
    insts = find_instances(cwd, runtimes)
    for inst in insts:
        known = inst["name"] in cfg["blueprints"]
        print(f"  {'✓' if known else '!'} {inst['path'].name}" + ("" if known else "  orphaned (no blueprint; cell clean " + inst["name"] + ")"))
        if (inst["path"] / SETTINGS_FILE).exists():
            try:
                json.loads((inst["path"] / SETTINGS_FILE).read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError):
                bad(f"{inst['path'].name}/settings.json is not valid JSON")
    if not insts:
        print("  (none)")
    repo = git_repo(cwd) if insts else None
    if repo:
        try:
            names = [i["path"].name for i in insts]
            r = subprocess.run(["git", "-C", str(cwd), "ls-files", "--"] + names,
                               capture_output=True, text=True, timeout=10)
            tracked = sorted({n for n in names for line in r.stdout.splitlines()
                              if line == n or line.startswith(n + "/")})
            r = subprocess.run(["git", "-C", str(cwd), "check-ignore", "--"] + [n + "/" for n in names],
                               capture_output=True, text=True, timeout=10)
            ignored = {line.rstrip("/") for line in r.stdout.splitlines()}
            exposed = [n for n in names if n not in ignored and n not in tracked]
            if tracked:
                bad(f"committed to git (they hold logins!): {', '.join(tracked)}  "
                    f"-> git rm -r --cached {' '.join(shlex.quote(t) for t in tracked)} && git commit -m 'untrack env dirs'")
            if exposed:
                bad(f"not git-ignored: {', '.join(exposed)}  -> next 'cell run' here fixes it, "
                    f"or: echo '{GIT_EXCLUDE_LINE}' >> {repo[1]}")
            if not tracked and not exposed:
                print("  ✓ git-ignored, none committed")
        except (OSError, subprocess.SubprocessError):
            pass
    print("ok" if not problems else f"{problems} problem{'s' if problems > 1 else ''} found")
    return 0 if not problems else 1


