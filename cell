        if vc["engine"] == "local":
            py = voice_python(vc)
            if py.exists() and subprocess.run([str(py), "-c", "import faster_whisper"], capture_output=True).returncode == 0:
                mdir = voice_dir() / "models"
                cached = mdir.is_dir() and any(p.name.endswith(f"-{vc['model']}") for p in mdir.glob("models--*"))
                print(f"  ✓ engine local: faster-whisper, model {vc['model']}"
                      + ("" if cached else "  (not downloaded yet: cell voice setup)"))
            else:
                bad(f"engine local: faster_whisper missing in {py} (cell voice setup)")
        elif voice_api_key(cfg, vc):
            print(f"  ✓ engine api: {vc['api_url']} ({vc['api_model']})")
        else:
            bad(f"engine api: no key — export {vc['api_key_env']} or 'cell keys set voice'")
        _, rec = find_recorder(vc)
        if rec:
            print(f"  ✓ recorder: {rec}")
        else:
            bad("no recorder: install pulseaudio-utils (parecord), alsa-utils (arecord) or pipewire")
        skill = seed_dir("claude") / "skills" / "voice" / "SKILL.md"
        if skill.is_file():
            print("  ✓ /voice skill seeded for claude envs")
        else:
