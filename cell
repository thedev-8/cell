def _helo_config_path() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(xdg) / "helo" / "config.toml"


def _bp_from_helo(data: dict, cfg: dict, helo_keys: dict | None = None) -> dict:
    api_key = data.get("api_key", "") or ""
    provider = data.get("provider", "") or "anthropic"
    # helo marks a subscription login as api_key = "max", either in the
    # blueprint or once per provider under [keys]. A login-capable provider
    # with no key anywhere can only sign in, so record that as login too.
    helo_key = (helo_keys or {}).get(provider, "") or ""
    login = (api_key == "max"
             or (not api_key and helo_key == "max")
             or (not api_key and not helo_key and not cfg.get("keys", {}).get(provider)
                 and bool(get_providers(cfg).get(provider, {}).get("login"))))
    hooks = {k: bool(v) for k, v in (data.get("hooks") or {}).items()} or _hooks_default(cfg)
    return {
        "runtime": data.get("runtime", "claude") or "claude",
        "provider": provider,
        "model": data.get("model", "") or "",
        "auth": "login" if login else "",
        "api_key": "" if login else api_key,
        "key_env": "",
        "persona": data.get("claude_md", "") or "",
        "permissions": {"bypass": "bypass", "accept-edits": "accept-edits", "plan": "plan"}.get(
            data.get("permissions", ""), ""),
        "hooks": hooks,
    }


def cmd_import(args, cfg):
    """Import helo blueprints: from ~/.config/helo/config.toml ([[blueprints]]
    + [keys]) and/or from .helo.toml instance files under a directory."""
    found = []
    helo_keys = {}
    helo_cfg = Path(args.config).expanduser() if args.config else _helo_config_path()
    if helo_cfg.exists():
        try:
            with open(helo_cfg, "rb") as f:
                data = tomllib.load(f)
        except tomllib.TOMLDecodeError as e:
            raise CellError(f"{helo_cfg}: {e}")
        for bp in data.get("blueprints") or []:
            if isinstance(bp, dict) and bp.get("name"):
                found.append((bp["name"], bp, helo_cfg))
        helo_keys = {k: v for k, v in (data.get("keys") or {}).items() if isinstance(v, str)}
        for prov, key in helo_keys.items():
            if key and key != "max" and not cfg["keys"].get(prov):
                cfg["keys"][prov] = key
                print(f"  key for '{prov}' copied ({mask(key)})")
    elif args.config:
        raise CellError(f"{helo_cfg} not found")
    if args.dir or not found:
        root = Path(args.dir or ".").expanduser()
        pattern = "**/.helo.toml" if args.recursive else "*/.helo.toml"
        for p in sorted(root.glob(pattern)):
            try:
                with open(p, "rb") as f:
                    d = tomllib.load(f)
            except (tomllib.TOMLDecodeError, OSError):
                continue
            if d.get("name") and all(n != d["name"] for n, _, _ in found):
                found.append((d["name"], d, p))
    if not found:
        raise CellError(f"nothing to import: no {helo_cfg} and no .helo.toml files under {args.dir or '.'}")
    merged = {}
    for name, data, src in found:
        bp = _bp_from_helo(data, cfg, helo_keys)
        if name in merged:                       # helo lists partial duplicates; later wins per field
            for k, v in bp.items():
                if v not in ("", None, {}):
                    merged[name][k] = v
        else:
            merged[name] = bp
    providers = get_providers(cfg)
    for name, bp in merged.items():
        if name in cfg["blueprints"] and not args.force:
            print(f"  skip '{name}' (exists; --force to overwrite)")
            continue
        state = "login" if bp["auth"] == "login" else ("key copied" if bp["api_key"] else "")
        if bp["provider"] not in providers:
            state += f" (provider '{bp['provider']}' unknown: cell provider add {bp['provider']} …)"
        print(f"  {'would import' if args.dry_run else 'imported'} '{name}': {bp['runtime']}/{bp['provider']}/{bp['model']}"
              + (f"  persona={bp['persona']}" if bp["persona"] else "")
              + (f"  permissions={bp['permissions']}" if bp["permissions"] else "")
              + (f"  [{state.strip()}]" if state.strip() else ""))
        cfg["blueprints"][name] = bp
    if args.dry_run:
        print("dry run — nothing written")
        return
    save_config(cfg)
    print("done — check with 'cell list' and 'cell doctor'")
    print("tip: 'cell hooks import .claude-env-<name>' copies the hooks of an existing env into cell")


